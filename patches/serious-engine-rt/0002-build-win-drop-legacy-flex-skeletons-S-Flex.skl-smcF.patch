From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lethalbas <lethalbas@gmail.com>
Date: Fri, 27 Nov 2026 19:51:48 +0100
Subject: [PATCH] build(win): drop legacy flex skeletons (-S
 Flex.skl/smcFlex.skl)

flex 2.6.4 (win_flex 2.5.25) rejects the flex-2.5-era skeleton files
with 'fatal internal error, bad line in skeleton file'. Use flex's
built-in skeleton instead, as the Classic-VK CMake build does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Sources/Engine/Engine.vcxproj | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/Sources/Engine/Engine.vcxproj b/Sources/Engine/Engine.vcxproj
index af143f23e121da84ae37b330c615bbace77d017b..98951ea1040a68071001508417800dc14849806c 100644
--- a/Sources/Engine/Engine.vcxproj
+++ b/Sources/Engine/Engine.vcxproj
@@ -1422,14 +1422,14 @@ del %(RootDir)%(Directory)\Parser.c /q</Command>
     </CustomBuild>
     <CustomBuild Include="Base\Scanner.l">
       <FileType>Document</FileType>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp -S%(RootDir)%(Directory)\Flex.skl %(RootDir)%(Directory)\Scanner.l</Command>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp -S%(RootDir)%(Directory)\Flex.skl %(RootDir)%(Directory)\Scanner.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp %(RootDir)%(Directory)\Scanner.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp %(RootDir)%(Directory)\Scanner.l</Command>
       <Message Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">Generating shell scanner source</Message>
       <Message Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">Generating shell scanner source</Message>
       <Outputs Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">%(RootDir)%(Directory)\Scanner.cpp;%(Outputs)</Outputs>
       <Outputs Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">%(RootDir)%(Directory)\Scanner.cpp;%(Outputs)</Outputs>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp -S%(RootDir)%(Directory)\Flex.skl %(RootDir)%(Directory)\Scanner.l</Command>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Release|x64'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp -S%(RootDir)%(Directory)\Flex.skl %(RootDir)%(Directory)\Scanner.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp %(RootDir)%(Directory)\Scanner.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Release|x64'">win_flex -o%(RootDir)%(Directory)\Scanner.cpp %(RootDir)%(Directory)\Scanner.l</Command>
       <Message Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">Generating shell scanner source</Message>
       <Message Condition="'$(Configuration)|$(Platform)'=='Release|x64'">Generating shell scanner source</Message>
       <Outputs Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">%(RootDir)%(Directory)\Scanner.cpp;%(Outputs)</Outputs>
@@ -1467,12 +1467,12 @@ del %(RootDir)%(Directory)\smcPars.c /q</Command>
     </CustomBuild>
     <CustomBuild Include="Ska\smcScan.l">
       <FileType>Document</FileType>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp -S%(RootDir)%(Directory)\smcFlex.skl %(RootDir)%(Directory)\smcScan.l</Command>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp -S%(RootDir)%(Directory)\smcFlex.skl %(RootDir)%(Directory)\smcScan.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp %(RootDir)%(Directory)\smcScan.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp %(RootDir)%(Directory)\smcScan.l</Command>
       <Outputs Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">%(RootDir)%(Directory)\smcScan.cpp;%(Outputs)</Outputs>
       <Outputs Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">%(RootDir)%(Directory)\smcScan.cpp;%(Outputs)</Outputs>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp -S%(RootDir)%(Directory)\smcFlex.skl %(RootDir)%(Directory)\smcScan.l</Command>
-      <Command Condition="'$(Configuration)|$(Platform)'=='Release|x64'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp -S%(RootDir)%(Directory)\smcFlex.skl %(RootDir)%(Directory)\smcScan.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp %(RootDir)%(Directory)\smcScan.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Release|x64'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp %(RootDir)%(Directory)\smcScan.l</Command>
       <Outputs Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">%(RootDir)%(Directory)\smcScan.cpp;%(Outputs)</Outputs>
       <Outputs Condition="'$(Configuration)|$(Platform)'=='Release|x64'">%(RootDir)%(Directory)\smcScan.cpp;%(Outputs)</Outputs>
     </CustomBuild>
