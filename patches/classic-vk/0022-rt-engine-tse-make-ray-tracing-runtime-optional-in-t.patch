+#include <Engine/StdH.h>
+#include <Engine/Base/Console.h>
+#include "RTGL1Loader.h"
+
+#ifdef PLATFORM_WIN32
+
+#include <delayimp.h>
+
+#define RTGL1_DLL_NAME "RayTracedGL1.dll"
+
+static INDEX _iRTGL1State = -1;   // -1 = not probed, 0 = unavailable, 1 = available
+static const char *_strRTGL1Reason = "not probed";
+
+// SEH helper: binds all delay-loaded imports of RayTracedGL1.dll, so a DLL with a
+// mismatching export table is detected here instead of crashing on first use.
+static HRESULT BindAllRTGL1Imports(void)
+{
+  __try {
+    return __HrLoadAllImportsForDll(RTGL1_DLL_NAME);
+  } __except (EXCEPTION_EXECUTE_HANDLER) {
+    return E_FAIL;
+  }
+}
+
+BOOL RTGL1_IsAvailable(void)
+{
+  if (_iRTGL1State >= 0) {
+    return _iRTGL1State == 1;
+  }
+
+  _iRTGL1State = 0;
+
+  // standard DLL search order (application directory first); the module stays loaded,
+  // the delay-load helper then reuses it
+  HMODULE hRTGL1 = LoadLibraryA(RTGL1_DLL_NAME);
+  if (hRTGL1 == NULL) {
+    _strRTGL1Reason = RTGL1_DLL_NAME " not found";
+    CPrintF("Ray tracing unavailable: %s\n", _strRTGL1Reason);
+    return FALSE;
+  }
+
+  if (FAILED(BindAllRTGL1Imports())) {
+    _strRTGL1Reason = RTGL1_DLL_NAME " does not export the expected RTGL1 API";
+    CPrintF("Ray tracing unavailable: %s\n", _strRTGL1Reason);
+    return FALSE;
+  }
+
+  _strRTGL1Reason = "";
+  _iRTGL1State = 1;
+  CPrintF("Ray tracing library " RTGL1_DLL_NAME " loaded.\n");
+  return TRUE;
+}
+
+const char *RTGL1_UnavailableReason(void)
+{
+  return _strRTGL1Reason;
+}
+
+#else // PLATFORM_WIN32
+
+// TODO(SSTRE, EXP-005 M3): Linux needs dlopen() + a function table for the rg*()
+// entry points; until then ray tracing is reported as unavailable.
+BOOL RTGL1_IsAvailable(void)
+{
+  return FALSE;
+}
+
+const char *RTGL1_UnavailableReason(void)
+{
+  return "ray tracing is not implemented on this platform";
+}
+
+#endif // PLATFORM_WIN32
