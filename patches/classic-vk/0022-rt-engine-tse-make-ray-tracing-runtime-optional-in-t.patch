+#ifndef SE_INCL_RTGL1LOADER_H
+#define SE_INCL_RTGL1LOADER_H
+#ifdef PRAGMA_ONCE
+  #pragma once
+#endif
+
+// Runtime-optional ray tracing: the engine links RayTracedGL1 as a delay-loaded
+// DLL (Windows), so Engine.dll starts without it. Every path into an rg*() call
+// must first check RTGL1_IsAvailable(); the conventional raster APIs never do.
+
+// Returns TRUE if the RayTracedGL1 library can be loaded and all its imports
+// resolve. The result is cached after the first call.
+BOOL RTGL1_IsAvailable(void);
+
+// Short human-readable reason why RTGL1_IsAvailable() returned FALSE.
+const char *RTGL1_UnavailableReason(void);
+
+#endif // SE_INCL_RTGL1LOADER_H
