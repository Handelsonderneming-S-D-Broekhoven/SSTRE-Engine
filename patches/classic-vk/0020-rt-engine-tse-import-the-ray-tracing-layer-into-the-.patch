+bool SSRT::CustomInfo::IsPotentialForcedAdd(const FLOAT3D &vPos) const
+{
+  // very specific light in sand canyon
+  return eCurrentWorld == EWorld::SandCanyon && (vPos - FLOAT3D(8.5f, -22.125f, -193.5f)).ManhattanNorm() < 1.0f;
+}
