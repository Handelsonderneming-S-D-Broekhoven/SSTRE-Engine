From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lethalbas <lethalbas@gmail.com>
Date: Fri, 27 Nov 2026 21:27:33 +0100
Subject: [PATCH] feat(bench): add +demo command-line option for benchmark
 playback

Start a single demo file from the command line after the display mode is
set, the same way the auto-play loop starts demos (observer, local
provider). +script runs before the menus initialise, so a PlayDemo() call
there is stopped again, and the shell PlayDemo(CTString) argument passing
is broken on x64. This gives an input-free, deterministic benchmark start
(SSTRE POC-28). On failure the main menu starts as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 SamTFE/Sources/SeriousSam/CmdLine.cpp    |  3 +++
 SamTFE/Sources/SeriousSam/CmdLine.h      |  1 +
 SamTFE/Sources/SeriousSam/SeriousSam.cpp | 16 ++++++++++++++++
 SamTSE/Sources/SeriousSam/CmdLine.cpp    |  3 +++
 SamTSE/Sources/SeriousSam/CmdLine.h      |  1 +
 SamTSE/Sources/SeriousSam/SeriousSam.cpp | 16 ++++++++++++++++
 6 files changed, 40 insertions(+)

diff --git a/SamTFE/Sources/SeriousSam/CmdLine.cpp b/SamTFE/Sources/SeriousSam/CmdLine.cpp
index 446ab0701ab858c141678e4fc9051e9a4e88ec41..4b6ddddf0153dc5b9f6ca10019f5b7e1c983ae20 100644
--- a/SamTFE/Sources/SeriousSam/CmdLine.cpp
+++ b/SamTFE/Sources/SeriousSam/CmdLine.cpp
@@ -19,6 +19,7 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 #include "CmdLine.h"
 
 CTString cmd_strWorld = "";  // world to load
+CTString cmd_strDemo = "";   // demo to play (SSTRE: deterministic benchmark playback)
 INDEX cmd_iGoToMarker = -1;  // marker to go to
 CTString cmd_strScript = ""; // script to execute
 CTString cmd_strServer = ""; // server to connect to
@@ -107,6 +108,8 @@ void ParseCommandLine(CTString strCmd)
       return;
     } else if (strWord=="+level") {
       cmd_strWorld = GetNextParam();
+    } else if (strWord=="+demo") {
+      cmd_strDemo = GetNextParam();
     } else if (strWord=="+server") {
       cmd_bServer = TRUE;
     } else if (strWord=="+quickjoin") {
