-    bool LoadTextureFile(const char *pFilePath, ktxTexture **ppTexture);
+    // Reads and validates a KTX2 file via the clean-room reader (Ktx2Reader.h)
+    std::unique_ptr<Ktx2::Texture> LoadTextureFile(const char *pFilePath);
 
 private:
     std::shared_ptr<UserFileLoad> userFileLoad;
-    std::vector<void *> loadedImages;
+    std::vector<std::unique_ptr<Ktx2::Texture>> loadedImages;
 };
 
