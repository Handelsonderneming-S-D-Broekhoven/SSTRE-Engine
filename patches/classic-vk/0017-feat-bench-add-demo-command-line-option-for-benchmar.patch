+++ b/SamTFE/Sources/SeriousSam/SeriousSam.cpp
@@ -907,6 +907,22 @@ BOOL Init( HINSTANCE hInstance, int nCmdShow, CTString strCmdLine)
     } catch (const char *strError) {
       CPrintF(TRANSV("Cannot start '%s': '%s'\n"), (const char *) cmd_strWorld, (const char *) strError);
     }
+  // if playing a demo from command line (SSTRE: benchmark playback without menus or input)
+  } else if (cmd_strDemo!="") {
+    CPrintF("Command line demo: '%s'\n", (const char *) cmd_strDemo);
+    _pGame->gm_StartSplitScreenCfg = CGame::SSC_OBSERVER;
+    _pGame->gm_aiStartLocalPlayers[0] = -1;
+    _pGame->gm_aiStartLocalPlayers[1] = -1;
+    _pGame->gm_aiStartLocalPlayers[2] = -1;
+    _pGame->gm_aiStartLocalPlayers[3] = -1;
+    _pGame->gm_strNetworkProvider = "Local";
+    _gmRunningGameMode = GM_NONE;
+    if (_pGame->StartDemoPlay(cmd_strDemo)) {
+      _gmRunningGameMode = GM_DEMO;
+      CON_DiscardLastLineTimes();
+    } else {
+      StartMenus();
+    }
   // if no relevant starting at command line
   } else {
     // RT: no auto-demos under ray tracing (SSTRE: runtime check instead of SE1_RAYTRACING)
