+{ 1000340000,  2,  1,  1,  1, 2 }, // VK_FORMAT_A4R4G4B4_UNORM_PACK16
+{ 1000340001,  2,  1,  1,  1, 2 }, // VK_FORMAT_A4B4G4R4_UNORM_PACK16
+{ 1000470000,  2,  1,  1,  1, 2 }, // VK_FORMAT_A1B5G5R5_UNORM_PACK16_KHR
+{ 1000470001,  1,  1,  1,  1, 1 }, // VK_FORMAT_A8_UNORM_KHR
diff --git a/Source/Ktx2Reader.cpp b/Source/Ktx2Reader.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f94c97ca6abba4b38c7d141a72f0776eca7d4700
--- /dev/null
+++ b/Source/Ktx2Reader.cpp
@@ -0,0 +1,570 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 Handelsonderneming S.D. Broekhoven, trading as ITEagle Europe
+//
+// Clean-room KTX 2.0 container reader. See Ktx2Reader.h for scope and sources.
+// Section names in comments refer to the KTX 2.0 specification.
+
+#include "Ktx2Reader.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <iterator>
+#include <limits>
+#include <memory>
+#include <new>
+
+#include <zstd.h>
+
+namespace RTGL1
+{
+namespace Ktx2
+{
+
+namespace
+{
+
+constexpr FormatInfo FORMAT_TABLE[] = {
+#include "Ktx2FormatTable.inl"
+};
+
+// "identifier"
+constexpr uint8_t FILE_IDENTIFIER[ 12 ] = {
+    0xAB, 0x4B, 0x54, 0x58, 0x20, 0x32, 0x30, 0xBB, 0x0D, 0x0A, 0x1A, 0x0A,
+};
+
+// "File Structure": identifier, 9 x UInt32, index (4 x UInt32 + 2 x UInt64).
+constexpr uint64_t HEADER_SIZE      = 12 + 9 * 4;
+constexpr uint64_t INDEX_SIZE       = 4 * 4 + 2 * 8;
+constexpr uint64_t LEVEL_ENTRY_SIZE = 3 * 8;
+
+// floor(log2(2^32-1)) + 1
+constexpr uint32_t MAX_LEVELS_ANY = 32;
+
+uint32_t ReadU32( const uint8_t *p )
+{
+    return uint32_t( p[ 0 ] ) | uint32_t( p[ 1 ] ) << 8 | uint32_t( p[ 2 ] ) << 16 |
+           uint32_t( p[ 3 ] ) << 24;
+}
+
+uint64_t ReadU64( const uint8_t *p )
+{
+    return uint64_t( ReadU32( p ) ) | uint64_t( ReadU32( p + 4 ) ) << 32;
+}
+
+// Overflow-checked arithmetic. Return false on overflow.
+bool Add( uint64_t a, uint64_t b, uint64_t *r )
+{
+    if( a > std::numeric_limits< uint64_t >::max() - b )
+    {
+        return false;
+    }
+    *r = a + b;
+    return true;
+}
+
+bool Mul( uint64_t a, uint64_t b, uint64_t *r )
+{
+    if( a != 0 && b > std::numeric_limits< uint64_t >::max() / a )
+    {
+        return false;
+    }
+    *r = a * b;
+    return true;
+}
+
+// [offset, offset+length) lies inside [0, size)
+bool RangeInFile( uint64_t offset, uint64_t length, uint64_t size )
+{
+    return offset <= size && length <= size - offset;
+}
+
+struct Range
+{
+    uint64_t begin;
+    uint64_t end;
+};
+
+bool Overlaps( const Range &a, const Range &b )
+{
+    return a.begin < b.end && b.begin < a.end;
+}
+
+uint32_t Gcd( uint32_t a, uint32_t b )
+{
+    while( b != 0 )
+    {
+        uint32_t t = a % b;
+        a          = b;
+        b          = t;
+    }
+    return a;
+}
+
+// lcm(blockBytes, 4): alignment of levels ("mipPadding")
+uint32_t LevelAlignment( const FormatInfo &f )
+{
+    return f.blockBytes / Gcd( f.blockBytes, 4 ) * 4;
+}
+
+uint32_t FloorLog2( uint32_t v )
+{
+    uint32_t r = 0;
+    while( v >>= 1 )
+    {
+        r++;
+    }
+    return r;
+}
+
+uint32_t CeilDiv( uint32_t a, uint32_t b )
+{
+    return a / b + ( a % b != 0 ? 1 : 0 );
+}
+
+struct ZstdDCtxDeleter
+{
+    void operator()( ZSTD_DCtx *p ) const { ZSTD_freeDCtx( p ); }
+};
+
+Result ParseKeyValueData( const uint8_t *p, uint64_t length, std::vector< KeyValue > *pOut )
+{
+    // "Key/Value Data": UInt32 keyAndValueByteLength, Byte keyAndValue[], align(4)
+    uint64_t pos = 0;
+    while( pos < length )
+    {
+        if( length - pos < 4 )
+        {
+            return Result::ErrorInvalidKeyValueData;
+        }
+        const uint32_t kvLen = ReadU32( p + pos );
+        pos += 4;
+
+        if( kvLen == 0 || kvLen > length - pos )
+        {
+            return Result::ErrorInvalidKeyValueData;
+        }
+
+        const uint8_t *kv  = p + pos;
+        const void    *nul = std::memchr( kv, 0, kvLen );
+        if( nul == nullptr || nul == kv )
+        {
+            // key must be a non-empty NUL-terminated UTF-8 string
+            return Result::ErrorInvalidKeyValueData;
+        }
+        const size_t keyLen = static_cast< const uint8_t * >( nul ) - kv;
+
+        KeyValue entry;
+        entry.key.assign( reinterpret_cast< const char * >( kv ), keyLen );
+        entry.value.assign( kv + keyLen + 1, kv + kvLen );
+        pOut->push_back( std::move( entry ) );
+
+        pos += kvLen;
+        // valuePadding; the final padding may be omitted by the writer
+        pos = std::min< uint64_t >( ( pos + 3 ) & ~uint64_t( 3 ), length );
+    }
+    return Result::Success;
+}
+
+Result ReadImpl( const uint8_t *file, uint64_t fileSize, Texture *t, const Limits &limits )
+{
+    if( fileSize < HEADER_SIZE + INDEX_SIZE + LEVEL_ENTRY_SIZE )
+    {
+        return Result::ErrorTruncated;
+    }
+
+    if( std::memcmp( file, FILE_IDENTIFIER, sizeof( FILE_IDENTIFIER ) ) != 0 )
+    {
+        return Result::ErrorIdentifier;
+    }
+
+    const uint8_t *h          = file + 12;
+    t->vkFormat               = ReadU32( h + 0 );
+    t->typeSize               = ReadU32( h + 4 );
+    t->pixelWidth             = ReadU32( h + 8 );
+    t->pixelHeight            = ReadU32( h + 12 );
+    t->pixelDepth             = ReadU32( h + 16 );
+    t->layerCount             = ReadU32( h + 20 );
+    t->faceCount              = ReadU32( h + 24 );
+    t->levelCount             = ReadU32( h + 28 );
+    t->supercompressionScheme = ReadU32( h + 32 );
+
+    const uint8_t *idx        = file + HEADER_SIZE;
+    const uint32_t dfdOffset  = ReadU32( idx + 0 );
+    const uint32_t dfdLength  = ReadU32( idx + 4 );
+    const uint32_t kvdOffset  = ReadU32( idx + 8 );
+    const uint32_t kvdLength  = ReadU32( idx + 12 );
+    // sgdByteOffset (idx + 16) is not needed: no supported scheme has global data
+    const uint64_t sgdLength  = ReadU64( idx + 24 );
+
+    // --- supercompressionScheme
+    if( t->supercompressionScheme != SUPERCOMPRESSION_NONE &&
+        t->supercompressionScheme != SUPERCOMPRESSION_ZSTD )
+    {
+        return Result::ErrorUnsupportedSupercompression;
+    }
+
+    // --- vkFormat (VK_FORMAT_UNDEFINED, prohibited and unknown formats are
+    //     absent from the table)
+    const FormatInfo *fmt = FindFormat( t->vkFormat );
+    if( fmt == nullptr )
+    {
+        return Result::ErrorUnsupportedFormat;
+    }
+    // typeSize is only needed for endian conversion on big-endian hosts;
+    // it is not validated, to stay tolerant of writers that get it wrong.
+
+    // --- pixelWidth/Height/Depth, layerCount, faceCount ("Texture Type")
+    if( t->pixelWidth == 0 )
+    {
+        return Result::ErrorInvalidDimensions;
+    }
+    if( t->pixelWidth > limits.maxDimension || t->pixelHeight > limits.maxDimension ||
+        t->pixelDepth > limits.maxDimension || t->layerCount > limits.maxLayers )
+    {
+        return Result::ErrorLimitExceeded;
+    }
+    if( t->pixelHeight == 0 && t->pixelDepth != 0 )
+    {
+        return Result::ErrorInvalidDimensions;
+    }
+    if( t->pixelHeight == 0 && fmt->blockHeight > 1 )
+    {
+        return Result::ErrorInvalidDimensions;
+    }
+    if( t->pixelDepth == 0 && fmt->blockDepth > 1 )
+    {
+        return Result::ErrorInvalidDimensions;
+    }
+    if( t->faceCount != 1 && t->faceCount != 6 )
+    {
+        return Result::ErrorInvalidTextureType;
+    }
+    if( t->faceCount == 6 && ( t->pixelHeight != t->pixelWidth || t->pixelDepth != 0 ) )
+    {
+        return Result::ErrorInvalidTextureType;
+    }
+
+    // --- levelCount
+    const uint32_t maxSide = std::max( { t->pixelWidth, t->pixelHeight, t->pixelDepth } );
+    const uint32_t numLevels = t->NumLevels();
+    if( numLevels > FloorLog2( maxSide ) + 1 || numLevels > MAX_LEVELS_ANY )
+    {
+        return Result::ErrorInvalidLevelCount;
+    }
+
+    // --- level index must fit
+    const uint64_t levelIndexEnd = HEADER_SIZE + INDEX_SIZE + LEVEL_ENTRY_SIZE * numLevels;
+    if( levelIndexEnd > fileSize )
+    {
+        return Result::ErrorTruncated;
+    }
+
+    // --- Index: DFD (required), KVD, SGD
+    std::vector< Range > sections;
+    sections.push_back( { 0, levelIndexEnd } );
+
+    if( dfdLength < 4 || !RangeInFile( dfdOffset, dfdLength, fileSize ) )
+    {
+        return dfdLength < 4 ? Result::ErrorInvalidIndex : Result::ErrorTruncated;
+    }
+    if( ReadU32( file + dfdOffset ) != dfdLength ) // dfdTotalSize == dfdByteLength
+    {
+        return Result::ErrorInvalidIndex;
+    }
+    sections.push_back( { dfdOffset, uint64_t( dfdOffset ) + dfdLength } );
+
+    if( kvdLength > 0 )
+    {
+        if( !RangeInFile( kvdOffset, kvdLength, fileSize ) )
+        {
+            return Result::ErrorTruncated;
+        }
+        sections.push_back( { kvdOffset, uint64_t( kvdOffset ) + kvdLength } );
+    }
+
+    // Neither scheme 0 nor scheme 2 uses supercompression global data.
+    if( sgdLength != 0 )
+    {
+        return Result::ErrorInvalidIndex;
+    }
+
+    for( size_t i = 0; i < sections.size(); i++ )
+    {
+        for( size_t j = i + 1; j < sections.size(); j++ )
+        {
+            if( Overlaps( sections[ i ], sections[ j ] ) )
+            {
+                return Result::ErrorInvalidIndex;
+            }
+        }
+    }
+    uint64_t metadataEnd = 0;
+    for( const Range &r : sections )
+    {
+        metadataEnd = std::max( metadataEnd, r.end );
+    }
+
+    // --- Level Index
+    const uint32_t numLayers = t->NumLayers();
+    const uint32_t alignment = LevelAlignment( *fmt );
+
+    t->levels.resize( numLevels );
+    uint64_t totalData = 0;
+
+    for( uint32_t p = 0; p < numLevels; p++ )
+    {
+        const uint8_t *e = file + HEADER_SIZE + INDEX_SIZE + LEVEL_ENTRY_SIZE * p;
+        Level         &l = t->levels[ p ];
+
+        l.fileByteOffset         = ReadU64( e + 0 );
+        l.fileByteLength         = ReadU64( e + 8 );
+        l.uncompressedByteLength = ReadU64( e + 16 );
+
+        l.width  = std::max( 1u, t->pixelWidth >> p );
+        l.height = std::max( 1u, t->pixelHeight >> p );
+        l.depth  = std::max( 1u, t->pixelDepth >> p );
+
+        // expected size from "levelImages"
+        uint64_t image = fmt->blockBytes;
+        uint64_t expected;
+        if( !Mul( image, CeilDiv( l.width, fmt->blockWidth ), &image ) ||
+            !Mul( image, CeilDiv( l.height, fmt->blockHeight ), &image ) ||
+            !Mul( image, CeilDiv( l.depth, fmt->blockDepth ), &image ) ||
+            !Mul( image, uint64_t( numLayers ) * t->faceCount, &expected ) )
+        {
+            return Result::ErrorLimitExceeded;
+        }
+
+        if( l.fileByteLength == 0 )
+        {
+            return Result::ErrorInvalidLevelIndex;
+        }
+        if( !RangeInFile( l.fileByteOffset, l.fileByteLength, fileSize ) )
+        {
+            return Result::ErrorTruncated;
+        }
+        if( l.fileByteOffset < metadataEnd )
+        {
+            return Result::ErrorInvalidLevelIndex;
+        }
+        if( l.uncompressedByteLength != expected )
+        {
+            return Result::ErrorInvalidLevelSize;
+        }
+        if( t->supercompressionScheme == SUPERCOMPRESSION_NONE &&
+            l.fileByteLength != l.uncompressedByteLength )
+        {
+            return Result::ErrorInvalidLevelSize;
+        }
+
+        // "Mip Level Array": smaller levels are stored first, so level p+1
+        // must end at or before the start of level p.
+        if( p > 0 )
+        {
+            const Level &prev = t->levels[ p - 1 ];
+            if( l.fileByteOffset + l.fileByteLength > prev.fileByteOffset )
+            {
+                return Result::ErrorInvalidLevelIndex;
+            }
+        }
+
+        // place level in the output buffer
+        uint64_t aligned = ( totalData + alignment - 1 ) / alignment * alignment;
+        if( !Add( aligned, expected, &totalData ) || totalData > limits.maxDataBytes ||
+            totalData > std::numeric_limits< size_t >::max() )
+        {
+            return Result::ErrorLimitExceeded;
+        }
+        l.dataOffset = static_cast< size_t >( aligned );
+        l.dataSize   = static_cast< size_t >( expected );
+        l.imageSize  = static_cast< size_t >( image );
+    }
+
+    // --- Key/Value Data (metadata, validated but not interpreted)
+    if( kvdLength > 0 )
+    {
+        Result r = ParseKeyValueData( file + kvdOffset, kvdLength, &t->keyValues );
+        if( r != Result::Success )
+        {
+            return r;
+        }
+    }
+
+    // --- copy / inflate
+    try
+    {
+        t->data.assign( static_cast< size_t >( totalData ), 0 );
+    }
+    catch( const std::bad_alloc & )
+    {
+        return Result::ErrorOutOfMemory;
+    }
+
+    if( t->supercompressionScheme == SUPERCOMPRESSION_NONE )
+    {
+        for( const Level &l : t->levels )
+        {
+            std::memcpy( t->data.data() + l.dataOffset, file + l.fileByteOffset, l.dataSize );
+        }
+    }
+    else
+    {
+        std::unique_ptr< ZSTD_DCtx, ZstdDCtxDeleter > dctx( ZSTD_createDCtx() );
+        if( !dctx )
+        {
+            return Result::ErrorOutOfMemory;
+        }
+        for( const Level &l : t->levels )
+        {
+            // ZSTD_decompressDCtx handles concatenated and skippable frames
+            // and verifies frame checksums when present. The destination
+            // capacity bounds the output, so oversized frames fail.
+            size_t n = ZSTD_decompressDCtx( dctx.get(),
+                                            t->data.data() + l.dataOffset,
+                                            l.dataSize,
+                                            file + l.fileByteOffset,
+                                            static_cast< size_t >( l.fileByteLength ) );
+            if( ZSTD_isError( n ) || n != l.dataSize )
+            {
+                return Result::ErrorDecompression;
+            }
+        }
+    }
+
+    return Result::Success;
+}
+
+}
+
+const char *ResultToString( Result r )
+{
+    switch( r )
+    {
+        case Result::Success: return "Success";
+        case Result::ErrorFileIo: return "Cannot open or read file";
+        case Result::ErrorTruncated: return "File is truncated or a section lies outside the file";
+        case Result::ErrorIdentifier: return "Not a KTX 2.0 file (bad identifier)";
+        case Result::ErrorUnsupportedFormat: return "Unsupported or invalid vkFormat";
+        case Result::ErrorInvalidDimensions: return "Invalid pixel dimensions";
+        case Result::ErrorInvalidTextureType: return "Invalid faceCount/layerCount combination";
+        case Result::ErrorInvalidLevelCount: return "Invalid levelCount";
+        case Result::ErrorUnsupportedSupercompression: return "Unsupported supercompression scheme";
+        case Result::ErrorInvalidIndex: return "Invalid DFD/KVD/SGD index";
+        case Result::ErrorInvalidKeyValueData: return "Malformed key/value data";
+        case Result::ErrorInvalidLevelIndex: return "Invalid level index (range or order)";
+        case Result::ErrorInvalidLevelSize: return "Level byte length does not match format and size";
+        case Result::ErrorDecompression: return "Zstandard decompression failed";
+        case Result::ErrorLimitExceeded: return "Texture exceeds configured limits";
+        case Result::ErrorOutOfMemory: return "Out of memory";
+    }
+    return "Unknown error";
+}
+
+const FormatInfo *FindFormat( uint32_t vkFormat )
+{
+    // FORMAT_TABLE is sorted by vkFormat (see Tools/GenKtx2FormatTable.py)
+    const FormatInfo *begin = std::begin( FORMAT_TABLE );
+    const FormatInfo *end   = std::end( FORMAT_TABLE );
+    const FormatInfo *it    = std::lower_bound(
+        begin, end, vkFormat, []( const FormatInfo &f, uint32_t v ) { return f.vkFormat < v; } );
+    return it != end && it->vkFormat == vkFormat ? it : nullptr;
+}
+
+bool Texture::GetImageOffset( uint32_t level, uint32_t layer, uint32_t face, size_t *pOffset ) const
+{
+    if( level >= levels.size() || layer >= NumLayers() || face >= faceCount )
+    {
+        return false;
+    }
+    // "levelImages": images are concatenated in the order layer, face, slice
+    const Level &l = levels[ level ];
+    *pOffset       = l.dataOffset + ( size_t( layer ) * faceCount + face ) * l.imageSize;
+    return true;
+}
+
+const KeyValue *Texture::FindKey( const char *key ) const
+{
+    for( const KeyValue &kv : keyValues )
+    {
+        if( kv.key == key )
+        {
+            return &kv;
+        }
+    }
+    return nullptr;
+}
+
+Result Read( const void *pFileData, size_t fileSize, Texture *pOut, const Limits &limits )
+{
+    if( pOut == nullptr )
+    {
+        return Result::ErrorFileIo;
+    }
+    *pOut = Texture();
+    if( pFileData == nullptr )
+    {
+        return Result::ErrorTruncated;
+    }
+
+    Result r = ReadImpl( static_cast< const uint8_t * >( pFileData ), fileSize, pOut, limits );
+    if( r != Result::Success )
+    {
+        *pOut = Texture();
+    }
+    return r;
+}
+
+Result ReadFile( const char *pFilePath, Texture *pOut, const Limits &limits )
+{
+    if( pOut == nullptr || pFilePath == nullptr )
+    {
+        return Result::ErrorFileIo;
+    }
+    *pOut = Texture();
+
+    struct FileCloser
+    {
+        void operator()( FILE *f ) const { std::fclose( f ); }
+    };
+    std::unique_ptr< FILE, FileCloser > f( std::fopen( pFilePath, "rb" ) );
+    if( !f )
+    {
+        return Result::ErrorFileIo;
+    }
+
+    std::vector< uint8_t > bytes;
+    uint8_t                chunk[ 64 * 1024 ];
+    for( ;; )
+    {
+        size_t n = std::fread( chunk, 1, sizeof( chunk ), f.get() );
+        if( n > 0 )
+        {
+            if( bytes.size() + n > limits.maxFileBytes )
+            {
+                return Result::ErrorLimitExceeded;
+            }
+            try
+            {
+                bytes.insert( bytes.end(), chunk, chunk + n );
+            }
+            catch( const std::bad_alloc & )
+            {
+                return Result::ErrorOutOfMemory;
+            }
+        }
+        if( n < sizeof( chunk ) )
+        {
+            if( std::ferror( f.get() ) )
+            {
+                return Result::ErrorFileIo;
+            }
+            break;
+        }
+    }
+
+    return Read( bytes.data(), bytes.size(), pOut, limits );
+}
+
+}
+}
diff --git a/Source/Ktx2Reader.h b/Source/Ktx2Reader.h
new file mode 100644
index 0000000000000000000000000000000000000000..bdbeed80ad12f15482972ed37f0a88234fc84bf9
--- /dev/null
+++ b/Source/Ktx2Reader.h
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 Handelsonderneming S.D. Broekhoven, trading as ITEagle Europe
+//
+// Clean-room KTX 2.0 container reader.
+//
+// Written from the Khronos "KTX File Format Specification", version 2.0
+// (KhronosGroup/KTX-Specification, commit ac39917e8240f51db97715a2453134a42ff959fd)
+// and the public Zstandard API (zstd.h). It does not contain or derive from
+// libktx / KTX-Software code.
+//
+// Scope: reads the container, validates every header field, offset and length
+// against the file size, and returns the (optionally Zstandard-inflated) level
+// data. Supercompression schemes 0 (none) and 2 (Zstandard) are supported.
+// BasisLZ (1), ZLIB (3) and vendor schemes are rejected as unsupported, as is
+// VK_FORMAT_UNDEFINED (no transcoding is performed). vkFormat is passed through.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace RTGL1
+{
+namespace Ktx2
+{
+
+enum class Result : uint32_t
+{
+    Success = 0,
+    ErrorFileIo,                        // file could not be opened / read
+    ErrorTruncated,                     // smaller than the header or a declared section
+    ErrorIdentifier,                    // not a KTX 2.0 file
+    ErrorUnsupportedFormat,             // VK_FORMAT_UNDEFINED, prohibited or unknown vkFormat
+    ErrorInvalidDimensions,             // pixelWidth/Height/Depth invalid for the texture type
+    ErrorInvalidTextureType,            // faceCount / layerCount combination invalid
+    ErrorInvalidLevelCount,             // more levels than the base size allows
+    ErrorUnsupportedSupercompression,   // scheme other than 0 or 2
+    ErrorInvalidIndex,                  // DFD / KVD / SGD range invalid or overlapping
+    ErrorInvalidKeyValueData,           // malformed key/value entries
+    ErrorInvalidLevelIndex,             // level range outside file, wrong order or overlapping
+    ErrorInvalidLevelSize,              // level byte lengths do not match the format/dimensions
+    ErrorDecompression,                 // Zstandard data corrupt or wrong inflated length
+    ErrorLimitExceeded,                 // exceeds the caller-provided Limits
+    ErrorOutOfMemory,
+};
+
+const char *ResultToString(Result r);
+
+enum SupercompressionScheme : uint32_t
+{
+    SUPERCOMPRESSION_NONE    = 0,
+    SUPERCOMPRESSION_BASISLZ = 1,
+    SUPERCOMPRESSION_ZSTD    = 2,
+    SUPERCOMPRESSION_ZLIB    = 3,
+};
+
+// Hard caps applied before any allocation, to bound memory use on hostile input.
+struct Limits
+{
+    uint64_t maxFileBytes  = uint64_t(2) << 30;  // ReadFile only
+    uint64_t maxDataBytes  = uint64_t(1) << 30;  // total inflated level data
+    uint32_t maxDimension  = 1u << 16;           // pixelWidth/Height/Depth
+    uint32_t maxLayers     = 1u << 16;           // layerCount
+};
+
+struct FormatInfo
+{
+    uint32_t vkFormat;
+    uint32_t blockBytes;    // texel block size in bytes
+    uint32_t blockWidth;
+    uint32_t blockHeight;
+    uint32_t blockDepth;
+    uint32_t typeSize;
+};
+
+// Returns nullptr if the vkFormat is not supported by this reader.
+const FormatInfo *FindFormat(uint32_t vkFormat);
+
+struct Level
+{
+    // As stored in the file's level index.
+    uint64_t fileByteOffset;
+    uint64_t fileByteLength;
+    uint64_t uncompressedByteLength;
+
+    // Location of the inflated level inside Texture::data.
+    size_t   dataOffset;
+    size_t   dataSize;          // == uncompressedByteLength
+    size_t   imageSize;         // one layer/face (incl. all z slices)
+
+    uint32_t width;
+    uint32_t height;            // >= 1 (1D textures report 1)
+    uint32_t depth;             // >= 1
+};
+
+struct KeyValue
+{
+    std::string          key;
+    std::vector<uint8_t> value;     // raw bytes, as stored (may include a trailing NUL)
+};
+
+struct Texture
+{
+    // Header fields, verbatim.
+    uint32_t vkFormat               = 0;
+    uint32_t typeSize               = 0;
+    uint32_t pixelWidth             = 0;
+    uint32_t pixelHeight            = 0;
+    uint32_t pixelDepth             = 0;
+    uint32_t layerCount             = 0;
+    uint32_t faceCount              = 0;
+    uint32_t levelCount             = 0;
+    uint32_t supercompressionScheme = 0;
+
+    // Derived.
+    uint32_t NumLevels() const { return levelCount == 0 ? 1 : levelCount; }
+    uint32_t NumLayers() const { return layerCount == 0 ? 1 : layerCount; }
+    uint32_t NumDimensions() const { return pixelDepth > 0 ? 3 : pixelHeight > 0 ? 2 : 1; }
+    bool     IsArray() const { return layerCount > 0; }
+    bool     IsCubemap() const { return faceCount == 6; }
+    // levelCount == 0: the file holds only the base level and asks the
+    // consumer to generate the remaining levels.
+    bool     WantsGeneratedMipmaps() const { return levelCount == 0; }
+
+    std::vector<Level>    levels;       // index 0 = base (largest) level
+    std::vector<KeyValue> keyValues;
+    std::vector<uint8_t>  data;         // inflated level data, base level first;
+                                        // each level starts at a multiple of
+                                        // lcm(blockBytes, 4)
+
+    // Offset in 'data' of one image. Returns false if out of range.
+    bool GetImageOffset(uint32_t level, uint32_t layer, uint32_t face, size_t *pOffset) const;
+
+    // Finds a key/value entry; nullptr if absent.
+    const KeyValue *FindKey(const char *key) const;
+};
+
+// Parses a complete in-memory KTX2 file. On failure, *pOut is left empty.
+Result Read(const void *pFileData, size_t fileSize, Texture *pOut, const Limits &limits = Limits());
+
+// Reads the file from disk, then calls Read().
+Result ReadFile(const char *pFilePath, Texture *pOut, const Limits &limits = Limits());
+
+}
+}
