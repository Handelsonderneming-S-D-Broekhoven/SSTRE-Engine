+cutscene_light = 625 45 1064.5
+cutscene_light = 628.25 19.625 1055.56
+cutscene_light = 629.375 19.875 1054.25
+cutscene_light = 628.062 20.0625 1054.12
+cutscene_light = 626.531 19.625 1054.12
+cutscene_light = 628.25 19.625 1072.44
+cutscene_light = 629.375 19.875 1073.75
+cutscene_light = 628.062 20.0625 1073.88
+cutscene_light = 626.531 19.625 1073.88
+cutscene_light = 631.75 23.375 1064.12
