From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lethalbas <lethalbas@gmail.com>
Date: Sat, 28 Nov 2026 02:12:10 +0100
Subject: [PATCH] build(linux): compile TSE without the ray-tracing layer
 (SE1_RAYTRACING=0)

Same change as for the TFE tree, now that the TSE tree carries the RT
transplant: SE1_RAYTRACING in GfxLibrary.h (0 for CMake builds, set in
SamTSE/Sources/CMakeLists.txt), stubs for the CGfxLibrary RT entry
points and RT_Particle_* hooks in Gfx_RayTracing.cpp, #if SE1_RAYTRACING
around the blocks that use SSRT types (DrawPort.cpp, Render.cpp,
RenderModel.cpp, Gfx_wrapper.cpp), and CMake builds Gfx_RayTracing.cpp,
Raytracing/RTGL1Loader.cpp and Models/RTModelNormalsFix.cpp.

Windows behaviour is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 SamTSE/Sources/CMakeLists.txt                 | 10 ++++++
 SamTSE/Sources/Engine/Graphics/DrawPort.cpp   | 20 +++++++++++
 SamTSE/Sources/Engine/Graphics/GfxLibrary.h   | 13 ++++++++
 .../Engine/Graphics/Gfx_RayTracing.cpp        | 33 +++++++++++++++++++
 .../Sources/Engine/Graphics/Gfx_wrapper.cpp   |  4 +++
 SamTSE/Sources/Engine/Models/RenderModel.cpp  |  4 +++
 SamTSE/Sources/Engine/Rendering/Render.cpp    |  4 +++
 7 files changed, 88 insertions(+)

diff --git a/SamTSE/Sources/CMakeLists.txt b/SamTSE/Sources/CMakeLists.txt
index 53313ac3dd8db14d5289a1e5cb889709bb68c094..1198ae301e1fba8f1db891c8ef7de5399a2f2c65 100644
--- a/SamTSE/Sources/CMakeLists.txt
+++ b/SamTSE/Sources/CMakeLists.txt
@@ -123,6 +123,10 @@ endif()
 
 option(TFE "Compile a The First Encounter version" FALSE)
 
+# SSTRE: the ray-tracing layer is built only by the Windows x64 MSBuild projects
+# (see SE1_RAYTRACING in Engine/Graphics/GfxLibrary.h).
+add_definitions(-DSE1_RAYTRACING=0)
+
 if(INTERNAL_NAME STREQUAL "serioussam")
  add_definitions(-DFIRST_ENCOUNTER=1)
  if(USE_SYSTEM_VULKAN)
@@ -1229,6 +1233,9 @@ set(ENGINE_SRCS
     Engine/Graphics/TextureEffects.cpp
     Engine/Graphics/DrawPort.cpp
     Engine/Graphics/Gfx_wrapper.cpp
+    Engine/Graphics/Gfx_RayTracing.cpp
+    Engine/Raytracing/RTGL1Loader.cpp
+    Engine/Models/RTModelNormalsFix.cpp
     Engine/Graphics/DrawPort_Particles.cpp
     Engine/Graphics/Graphics.cpp
     Engine/Graphics/ViewPort.cpp
@@ -1410,6 +1417,9 @@ set(ENGINE_SRCS
     Engine/Graphics/TextureEffects.cpp
     Engine/Graphics/DrawPort.cpp
     Engine/Graphics/Gfx_wrapper.cpp
+    Engine/Graphics/Gfx_RayTracing.cpp
+    Engine/Raytracing/RTGL1Loader.cpp
+    Engine/Models/RTModelNormalsFix.cpp
     Engine/Graphics/DrawPort_Particles.cpp
     Engine/Graphics/Graphics.cpp
     Engine/Graphics/ViewPort.cpp
