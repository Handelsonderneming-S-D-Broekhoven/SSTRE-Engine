+#if SE1_RAYTRACING
 namespace SSRT
 {
 // Special static variables that are set in InitTexture(..) and used 
@@ -56,6 +59,7 @@ namespace SSRT
 static CTextureData *ssrt_pTextureData = nullptr;
 static GfxWrap ssrt_eWrap = GFX_REPEAT;
 }
+#endif // SE1_RAYTRACING
 
 
 
@@ -465,6 +469,7 @@ BOOL CDrawPort::Lock(void)
 
 
 // function for generating indices for quad HUD elements
+#if SE1_RAYTRACING
 void HudElement_GenerateQuadIndices(SSRT::CHudElementInfo *preparedInfo)
 {
   const INDEX ctElements = preparedInfo->vertexCount * 6 / 4;
@@ -496,6 +501,7 @@ void HudElement_GenerateQuadIndices(SSRT::CHudElementInfo *preparedInfo)
   preparedInfo->pIndices = &_aiCommonQuads[0];
   preparedInfo->indexCount = ctElements;
 }
+#endif // SE1_RAYTRACING
 
 
 // draw one point
@@ -988,6 +994,7 @@ void CDrawPort::Fill( PIX pixI, PIX pixJ, PIX pixWidth, PIX pixHeight,
     pvtx[3].x = fI1;  pvtx[3].y = fJ0;  pvtx[3].z = 0;  pcol[3] = glcolUR;
 
 
+#if SE1_RAYTRACING
     if (eAPI == GAT_RT)
     {
       SSRT::CHudElementInfo hudInfo = {};
@@ -1004,6 +1011,7 @@ void CDrawPort::Fill( PIX pixI, PIX pixJ, PIX pixWidth, PIX pixHeight,
 
       _pGfx->gl_SSRT->ProcessHudElement(hudInfo);
     }
+#endif // SE1_RAYTRACING
 
     gfxFlushQuads();
   }
@@ -1662,6 +1670,7 @@ void CDrawPort::PutText( const CTString &strText, PIX pixX0, PIX pixY0, const CO
 
 
   
+#if SE1_RAYTRACING
   if (eAPI == GAT_RT && _avtxCommon.Count() > 0)
   {
     SSRT::CHudElementInfo hudInfo = {};
@@ -1679,6 +1688,7 @@ void CDrawPort::PutText( const CTString &strText, PIX pixX0, PIX pixY0, const CO
 
     _pGfx->gl_SSRT->ProcessHudElement(hudInfo);
   }
+#endif // SE1_RAYTRACING
 
 
   gfxFlushQuads();
@@ -1818,6 +1828,7 @@ void CDrawPort::PutTexture( class CTextureObject *pTO,
   pcol[3] = glcolUR;
 
 
+#if SE1_RAYTRACING
   if (eAPI == GAT_RT)
   {    
     SSRT::CHudElementInfo hudInfo = {};
@@ -1835,6 +1846,7 @@ void CDrawPort::PutTexture( class CTextureObject *pTO,
 
     _pGfx->gl_SSRT->ProcessHudElement(hudInfo);
   }
+#endif // SE1_RAYTRACING
 
 
   gfxFlushQuads();
@@ -1857,22 +1869,26 @@ void CDrawPort::InitTexture( class CTextureObject *pTO, const BOOL bClamp/*=FALS
     if( bClamp) eWrap = GFX_CLAMP;
     gfxSetTextureWrapping( eWrap, eWrap);
     
+#if SE1_RAYTRACING
     if (eAPI == GAT_RT)
     {
       SSRT::ssrt_pTextureData = ptd;
       SSRT::ssrt_eWrap = eWrap;
     }
     else
+#endif // SE1_RAYTRACING
     {
       ptd->SetAsCurrent(pTO->GetFrame());
     }
   } 
   else 
   {
+#if SE1_RAYTRACING
     if (eAPI == GAT_RT)
     {
       SSRT::ssrt_pTextureData = nullptr;
     }
+#endif // SE1_RAYTRACING
 
     // no texture
     gfxDisableTexture();
@@ -2002,6 +2018,7 @@ void CDrawPort::FlushRenderingQueue(void) const
 {
   const GfxAPIType eAPI = _pGfx->gl_eCurrentAPI;
   
+#if SE1_RAYTRACING
   if (eAPI == GAT_RT)
   {
     SSRT::CHudElementInfo hudInfo = {};
@@ -2025,6 +2042,7 @@ void CDrawPort::FlushRenderingQueue(void) const
 
     SSRT::ssrt_pTextureData = nullptr;
   }
+#endif // SE1_RAYTRACING
 
   gfxFlushElements(); 
   gfxResetArrays(); 
@@ -2073,6 +2091,7 @@ void CDrawPort::BlendScreen(void)
 
   const GfxAPIType eAPI = _pGfx->gl_eCurrentAPI;
 
+#if SE1_RAYTRACING
   if (eAPI == GAT_RT && _avtxCommon.Count() > 0)
   {
     SSRT::CHudElementInfo hudInfo = {};
@@ -2089,6 +2108,7 @@ void CDrawPort::BlendScreen(void)
 
     _pGfx->gl_SSRT->ProcessHudElement(hudInfo);
   }
+#endif // SE1_RAYTRACING
   
   gfxFlushQuads();
   // reset accumulation color
diff --git a/SamTSE/Sources/Engine/Graphics/GfxLibrary.h b/SamTSE/Sources/Engine/Graphics/GfxLibrary.h
index 14b3fa4108ace94aa741037bc052db8e98c04d9e..230fd28a7870f674e7ddc793aa2e8bb4ef02bbfc 100644
--- a/SamTSE/Sources/Engine/Graphics/GfxLibrary.h
+++ b/SamTSE/Sources/Engine/Graphics/GfxLibrary.h
@@ -49,6 +49,19 @@ class SSRTMain;
 }
 #endif // SE1_VULKAN
 
+// SSTRE (GPL-2.0-only, Copyright (C) 2026 Handelsonderneming S.D. Broekhoven,
+// trading as ITEagle Europe): the ray-tracing layer (Engine/Raytracing, RTGL1)
+// is built only by the Windows x64 MSBuild projects. Other builds (CMake/Linux)
+// compile with SE1_RAYTRACING=0: raster APIs only, GAT_RT has no adapters and
+// its driver entry points are stubs (Gfx_RayTracing.cpp).
+#ifndef SE1_RAYTRACING
+  #if defined(SE1_VULKAN) && defined(_MSC_VER) && defined(_WIN64)
+    #define SE1_RAYTRACING 1
+  #else
+    #define SE1_RAYTRACING 0
+  #endif
+#endif
+
 
 // WARNING: Changing these constants breaks inline asm on GNU systems!
 #define SQRTTABLESIZE   8192
diff --git a/SamTSE/Sources/Engine/Graphics/Gfx_RayTracing.cpp b/SamTSE/Sources/Engine/Graphics/Gfx_RayTracing.cpp
index edd16b89117cb16671e42033ec590b903666c60b..307f2a41f4cefa2951a1c5e8739c14fee87cc9ef 100644
--- a/SamTSE/Sources/Engine/Graphics/Gfx_RayTracing.cpp
+++ b/SamTSE/Sources/Engine/Graphics/Gfx_RayTracing.cpp
@@ -20,6 +20,37 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 #include <Engine/Base/Console.h>
 
 #include <Engine/Graphics/GfxLibrary.h>
+
+#if !SE1_RAYTRACING
+// SSTRE (GPL-2.0-only, Copyright (C) 2026 Handelsonderneming S.D. Broekhoven,
+// trading as ITEagle Europe): build without the ray-tracing layer
+// (SE1_RAYTRACING=0, e.g. CMake/Linux). GAT_RT never gets an adapter there;
+// these stubs keep the raster code paths linkable.
+void CGfxLibrary::InitShellVariables_RayTracing() {}
+BOOL CGfxLibrary::InitDriver_RayTracing()
+{
+  CPrintF("Ray tracing is not available in this build.\n");
+  return FALSE;
+}
+void CGfxLibrary::InitContext_RayTracing() {}
+void CGfxLibrary::EndDriver_RayTracing() {}
+BOOL CGfxLibrary::SetCurrentViewport_RayTracing(CViewPort *pvp) { return FALSE; }
+void CGfxLibrary::StartFrame_RayTracing(CRaster *pRaster) {}
+void CGfxLibrary::EndFrame_RayTracing() {}
+void CGfxLibrary::SetViewport_RayTracing(float leftUpperX, float leftUpperY, float width, float height, float minDepth, float maxDepth) {}
+void CGfxLibrary::NotifyGameStoppedSafe_RayTracing() {}
+
+#include <Engine/Graphics/DrawPort.h>
+#include <Engine/Graphics/Texture.h>
+#include <Engine/Raytracing/RTProcessing.h>
+void RT_Particle_PrepareTexture(CTextureObject *pto, enum ParticleBlendType pbt) {}
+void RT_Particle_SetTexturePart(MEX mexWidth, MEX mexHeight, INDEX iCol, INDEX iRow) {}
+void RT_Particle_RenderSquare(const FLOAT3D &vPos, FLOAT fSize, ANGLE aRotation, COLOR col, FLOAT fYRatio) {}
+void RT_Particle_RenderLine(const FLOAT3D &vPos0, const FLOAT3D &vPos1, FLOAT fWidth, COLOR col) {}
+void RT_Particle_RenderQuad3D(const FLOAT3D &vPos0, const FLOAT3D &vPos1, const FLOAT3D &vPos2, const FLOAT3D &vPos3, COLOR col) {}
+void RT_Particle_Flush() {}
+#else // SE1_RAYTRACING
+
 #include <Engine/Graphics/Vulkan/SvkMain.h>
 #include <Engine/Graphics/ViewPort.h>
 
@@ -292,3 +323,5 @@ void CGfxLibrary::NotifyGameStoppedSafe_RayTracing()
     gl_SSRT->NotifyGameStopped();
   }
 }
+
+#endif // SE1_RAYTRACING
