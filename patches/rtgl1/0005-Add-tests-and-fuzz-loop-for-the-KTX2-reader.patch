+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 Handelsonderneming S.D. Broekhoven, trading as ITEagle Europe
+#
+# Black-box comparison of the clean-room KTX2 reader against the official
+# Khronos KTX-Software command line tool (used only as an oracle: it creates
+# the corpus and reports/extracts what it reads; its source is not used).
+#
+# usage: python corpus_compare.py <ktx.exe> <Ktx2ReaderTest.exe> <work-dir> [extra.ktx2 ...]
+#
+# For every file: `ktx validate`, `ktx info --format json` (header + level
+# index) and `ktx extract --all --raw` (image bytes) are compared with
+# `Ktx2ReaderTest info` / `Ktx2ReaderTest extract`.
+
+import json
+import os
+import random
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import zlib
+
+KTX, READER, WORK = sys.argv[1], sys.argv[2], sys.argv[3]
+EXTRA = sys.argv[4:]
+
+# name, format, blockBytes, block w/h, width, height, depth, layers, cubemap, levels, extra args
+CASES = [
+    ("rgba8_64_mips",        "R8G8B8A8_UNORM", 4, 1, 64, 64, 0, 0, False, 7, []),
+    ("rgba8_64_mips_zstd",   "R8G8B8A8_UNORM", 4, 1, 64, 64, 0, 0, False, 7, ["--zstd", "18"]),
+    ("rgba8srgb_odd_13x7",   "R8G8B8A8_SRGB",  4, 1, 13, 7, 0, 0, False, 4, []),
+    ("rgba8_odd_13x7_zstd",  "R8G8B8A8_UNORM", 4, 1, 13, 7, 0, 0, False, 4, ["--zstd", "3"]),
+    ("rgba8_1x1",            "R8G8B8A8_UNORM", 4, 1, 1, 1, 0, 0, False, 1, []),
+    ("rgba8_array5",         "R8G8B8A8_UNORM", 4, 1, 16, 16, 0, 5, False, 5, []),
+    ("rgba8_array5_zstd",    "R8G8B8A8_UNORM", 4, 1, 16, 16, 0, 5, False, 5, ["--zstd", "9"]),
+    ("rgba8_cube",           "R8G8B8A8_UNORM", 4, 1, 16, 16, 0, 0, True, 5, []),
+    ("rgba8_3d_8x8x4",       "R8G8B8A8_UNORM", 4, 1, 8, 8, 4, 0, False, 4, []),
+    ("rgba8_1d_32",          "R8G8B8A8_UNORM", 4, 1, 32, 0, 0, 0, False, 6, ["--1d"]),
+    ("rgb8_odd_5x3",         "R8G8B8_UNORM",   3, 1, 5, 3, 0, 0, False, 3, []),
+    ("r8_odd_7x5",           "R8_UNORM",       1, 1, 7, 5, 0, 0, False, 3, []),
+    ("rgba16f_32",           "R16G16B16A16_SFLOAT", 8, 1, 32, 32, 0, 0, False, 6, []),
+    ("rgba8_runtime_mips",   "R8G8B8A8_UNORM", 4, 1, 32, 32, 0, 0, False, 0, ["--runtime-mipmap"]),
+    ("bc1_64x32",            "BC1_RGB_UNORM_BLOCK", 8, 4, 64, 32, 0, 0, False, 7, []),
+    ("bc1_64x32_zstd",       "BC1_RGB_UNORM_BLOCK", 8, 4, 64, 32, 0, 0, False, 7, ["--zstd", "5"]),
+    ("bc1a_srgb_odd_10x6",   "BC1_RGBA_SRGB_BLOCK", 8, 4, 10, 6, 0, 0, False, 4, []),
+    ("bc3_128",              "BC3_UNORM_BLOCK", 16, 4, 128, 128, 0, 0, False, 8, []),
+    ("bc3_cube_32",          "BC3_SRGB_BLOCK", 16, 4, 32, 32, 0, 0, True, 6, []),
+    ("bc3_cube_32_zstd",     "BC3_UNORM_BLOCK", 16, 4, 32, 32, 0, 0, True, 6, ["--zstd", "10"]),
+    ("bc3_cubearray2_16",    "BC3_UNORM_BLOCK", 16, 4, 16, 16, 0, 2, True, 5, []),
+    ("bc5_array4_32x16",     "BC5_UNORM_BLOCK", 16, 4, 32, 16, 0, 4, False, 6, []),
+    ("bc5_array4_zstd",      "BC5_UNORM_BLOCK", 16, 4, 32, 16, 0, 4, False, 6, ["--zstd", "22"]),
+    ("bc5_snorm_odd_18x9",   "BC5_SNORM_BLOCK", 16, 4, 18, 9, 0, 0, False, 5, []),
+    ("bc7_256",              "BC7_UNORM_BLOCK", 16, 4, 256, 256, 0, 0, False, 9, []),
+    ("bc7_256_zstd",         "BC7_SRGB_BLOCK", 16, 4, 256, 256, 0, 0, False, 9, ["--zstd", "19"]),
+    ("bc7_odd_1000x3",       "BC7_UNORM_BLOCK", 16, 4, 1000, 3, 0, 0, False, 10, []),
+    ("bc7_nomips_2048",      "BC7_UNORM_BLOCK", 16, 4, 2048, 2048, 0, 0, False, 1, ["--zstd", "1"]),
+]
+
+
+def run(args, **kw):
+    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, **kw)
+
+
+def level_dim(v, p):
+    return max(1, v >> p)
+
+
+def write_png(path, w, h, rng):
+    raw = b"".join(b"\x00" + bytes(rng.getrandbits(8) for _ in range(w * 4)) for _ in range(h))
+    def chunk(t, d):
+        c = struct.pack(">I", len(d)) + t + d
+        return c + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)
+    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
+    png += chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b"")
+    open(path, "wb").write(png)
+
+
+def make_corpus(cdir):
+    rng = random.Random(20261127)
+    made = []
+    for (name, fmt, bb, bwh, w, h, d, layers, cube, levels, extra) in CASES:
+        src = os.path.join(cdir, "src_" + name)
+        os.makedirs(src, exist_ok=True)
+        inputs = []
+        nlev = max(1, levels)
+        nfaces = 6 if cube else 1
+        nlay = max(1, layers)
+        for p in range(nlev):
+            lw, lh, ld = level_dim(w, p), level_dim(max(h, 1), p), level_dim(max(d, 1), p)
+            size = bb * -(-lw // bwh) * (-(-lh // bwh) if h else 1)
+            for _ in range(nlay):
+                for _ in range(nfaces):
+                    for _ in range(ld if d else 1):
+                        fn = os.path.join(src, "in%03d.raw" % len(inputs))
+                        open(fn, "wb").write(bytes(rng.getrandbits(8) for _ in range(size)))
+                        inputs.append(fn)
+        out = os.path.join(cdir, name + ".ktx2")
+        args = [KTX, "create", "--format", fmt, "--raw", "--width", str(w), "--testrun"]
+        if h:
+            args += ["--height", str(h)]
+        else:
+            args += ["--height", "1"]
+        if d:
+            args += ["--depth", str(d)]
+        if layers:
+            args += ["--layers", str(layers)]
+        if cube:
+            args += ["--cubemap"]
+        if levels:
+            args += ["--levels", str(levels)]
+        args += [a for a in extra if a != "--1d"] + (["--1d"] if "--1d" in extra else [])
+        if "--runtime-mipmap" in extra:
+            args = [a for a in args if a != "--levels"]
+        r = run(args + inputs + [out])
+        if r.returncode != 0:
+            print("CREATE FAILED", name, r.stdout.decode(errors="replace").strip())
+            continue
+        made.append(out)
+    # one non-raw file with tool-generated mipmaps from a PNG
+    png = os.path.join(cdir, "src_png.png")
+    write_png(png, 96, 40, rng)
+    out = os.path.join(cdir, "png_genmips_zstd.ktx2")
+    r = run([KTX, "create", "--format", "R8G8B8A8_SRGB", "--generate-mipmap", "--zstd", "12", "--testrun", png, out])
+    if r.returncode == 0:
+        made.append(out)
+    else:
+        print("CREATE FAILED png", r.stdout.decode(errors="replace"))
+    # zlib-supercompressed file: must be rejected as unsupported
+    out = os.path.join(cdir, "unsupported_zlib.ktx2")
+    r = run([KTX, "create", "--format", "R8G8B8A8_UNORM", "--zlib", "6", "--testrun", png, out])
+    if r.returncode == 0:
+        made.append(out)
+    return made
+
+
+KTX_SC = {"KTX_SS_NONE": 0, "KTX_SS_BASIS_LZ": 1, "KTX_SS_ZSTD": 2, "KTX_SS_ZLIB": 3}
+
+
+def compare(path, vk_values):
+    name = os.path.basename(path)
+    problems = []
+    v = run([KTX, "validate", path])
+    official_valid = v.returncode == 0
+    oi = run([KTX, "info", "--format", "json", path])
+    official = json.loads(oi.stdout.decode()) if oi.returncode == 0 else None
+    mi = run([READER, "info", path])
+    mine = json.loads(mi.stdout.decode())
+    sc = KTX_SC.get(official["header"]["supercompressionScheme"]) if official else None
+
+    if not mine["ok"]:
+        expected_reject = sc == 3 or sc == 1
+        return ("REJECT-OK" if expected_reject else "REJECT-UNEXPECTED"), mine["error"], official_valid, 0
+    if not mine["invariants"]:
+        problems.append("invariants")
+
+    h = official["header"]
+    for k in ("typeSize", "pixelWidth", "pixelHeight", "pixelDepth", "layerCount", "faceCount", "levelCount"):
+        if h[k] != mine[k]:
+            problems.append("%s %s!=%s" % (k, h[k], mine[k]))
+    if vk_values.get(h["vkFormat"]) != mine["vkFormat"]:
+        problems.append("vkFormat %s!=%s" % (h["vkFormat"], mine["vkFormat"]))
+    if sc != mine["supercompressionScheme"]:
+        problems.append("scheme")
+    olev = official["index"]["levels"]
+    if len(olev) != len(mine["levels"]):
+        problems.append("level count")
+    for p, (a, b) in enumerate(zip(olev, mine["levels"])):
+        for k in ("byteOffset", "byteLength", "uncompressedByteLength"):
+            if a[k] != b[k]:
+                problems.append("level%d.%s %s!=%s" % (p, k, a[k], b[k]))
+
+    # bytes
+    ex_off = os.path.join(WORK, "x_official", name)
+    ex_me = os.path.join(WORK, "x_mine", name)
+    for dd in (ex_off, ex_me):
+        shutil.rmtree(dd, ignore_errors=True)
+        os.makedirs(dd)
+    r = run([KTX, "extract", "--all", "--raw", path, ex_off])
+    if r.returncode != 0:
+        problems.append("official extract failed: " + r.stdout.decode(errors="replace").strip())
+    r = run([READER, "extract", path, ex_me])
+    if r.returncode != 0:
+        problems.append("reader extract failed")
+    pat = re.compile(r"_level(\d+)|_layer(\d+)|_face(\d+)|_depth(\d+)|_z_slice(\d+)")
+    official_images = {}
+    for fn in os.listdir(ex_off):
+        idx = {"level": 0, "layer": 0, "face": 0, "depth": 0}
+        for m in pat.finditer(fn):
+            for key, val in zip(("level", "layer", "face", "depth", "depth"), m.groups()):
+                if val is not None:
+                    idx[key] = int(val)
+        official_images.setdefault((idx["level"], idx["layer"], idx["face"]), []).append(
+            (idx["depth"], open(os.path.join(ex_off, fn), "rb").read()))
+    compared = 0
+    for fn in os.listdir(ex_me):
+        m = re.match(r"level(\d+)_layer(\d+)_face(\d+)\.raw", fn)
+        key = tuple(int(x) for x in m.groups())
+        mine_bytes = open(os.path.join(ex_me, fn), "rb").read()
+        if key not in official_images:
+            problems.append("no official image for %s" % (key,))
+            continue
+        off_bytes = b"".join(b for _, b in sorted(official_images.pop(key)))
+        if off_bytes != mine_bytes:
+            problems.append("bytes differ %s (%d vs %d)" % (key, len(off_bytes), len(mine_bytes)))
+        compared += 1
+    if official_images:
+        problems.append("official images not produced by reader: %s" % sorted(official_images))
+    status = "MATCH" if not problems else "MISMATCH"
+    return status, "; ".join(problems), official_valid, compared
+
+
+def main():
+    cdir = os.path.join(WORK, "corpus")
+    os.makedirs(cdir, exist_ok=True)
+    files = make_corpus(cdir) + EXTRA
+    # vkFormat name -> value from the reader's own table is not exposed; use ktx info of the reader output
+    hdr = open(os.path.join(os.environ.get("VULKAN_SDK", r"C:\VulkanSDK\1.4.363.0"), "Include", "vulkan", "vulkan_core.h")).read()
+    vk_values = {m.group(1): int(m.group(2)) for m in re.finditer(r"\b(VK_FORMAT_\w+) = (\d+),", hdr)}
+    totals = {}
+    images = 0
+    for f in files:
+        status, msg, valid, n = compare(f, vk_values)
+        images += n
+        totals[status] = totals.get(status, 0) + 1
+        print("%-18s validate=%-5s images=%-4d %s %s" % (status, valid, n, os.path.basename(f), msg))
+    print("SUMMARY files=%d images=%d %s" % (len(files), images, totals))
+    return 0 if set(totals) <= {"MATCH", "REJECT-OK"} else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
