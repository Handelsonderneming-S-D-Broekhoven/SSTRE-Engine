+{
+  uint32_t              textureID;
+  const CTFileName      *path;
+  bool                  isDynamic;
+  void                  *imageData;
+  uint32_t              width;
+  uint32_t              height;
+  bool                  generateMipmaps;
+  RgSamplerFilter       filter;
+  RgSamplerAddressMode  wrapU;
+  RgSamplerAddressMode  wrapV;
+  bool                  disableOverride;
+};
+
+
+struct CPreparedAnimatedTextureInfo
+{
+  uint32_t              textureID;
+  const CTFileName      *path;
+  void                  *frameData;
+  uint32_t              frameCount;
+  uint64_t              frameStride;
+  uint32_t              width;
+  uint32_t              height;
+  bool                  generateMipmaps;
+  RgSamplerFilter       filter;
+  RgSamplerAddressMode  wrapU;
+  RgSamplerAddressMode  wrapV;
+};
+
