From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lethalbas <lethalbas@gmail.com>
Date: Sat, 28 Nov 2026 00:45:03 +0100
Subject: [PATCH] rt(game,tse): select GAT_RT at runtime in the TSE game exe

Replays 7d80a7d7 onto SamTSE/Sources/SeriousSam (MainWindow.cpp,
SeriousSam.cpp are identical between the TFE and TSE trees; applied
cleanly). Raster (Vulkan) stays the default; display-mode recovery
tries Vulkan raster first, then OpenGL.

Ported code: Serious-Engine-RT (https://github.com/sultim-t/Serious-Engine-RT,
GPL-2.0-only) by Sultim Tsyrendashiev; original copyright notices kept.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 SamTSE/Sources/SeriousSam/MainWindow.cpp |  4 +-
 SamTSE/Sources/SeriousSam/SeriousSam.cpp | 85 ++++++++++++++++++------
 2 files changed, 68 insertions(+), 21 deletions(-)

diff --git a/SamTSE/Sources/SeriousSam/MainWindow.cpp b/SamTSE/Sources/SeriousSam/MainWindow.cpp
index 6797075c427f98aa8f14a107098cf24594190aa1..cd7100bd3f73f2a09b8a7323c87718426af2a1fa 100644
--- a/SamTSE/Sources/SeriousSam/MainWindow.cpp
+++ b/SamTSE/Sources/SeriousSam/MainWindow.cpp
@@ -285,7 +285,7 @@ void OpenMainWindowNormal( PIX pixSizeI, PIX pixSizeJ)
   if (sam_bBorderLessActive) _uFlags |= SDL_WINDOW_BORDERLESS; 
   SDL_snprintf( achWindowTitle, sizeof (achWindowTitle), TRANSV("Serious Sam (Window %dx%d)"), pixSizeI, pixSizeJ);
 #ifdef SE1_VULKAN
-  if( sam_iGfxAPI == 1) {
+  if( sam_iGfxAPI == 1 || sam_iGfxAPI == 2) { // Vulkan raster or Vulkan ray tracing (GAT_RT)
     _uFlags = SDL_WINDOW_VULKAN;
     if (sam_bBorderLessActive) _uFlags |= SDL_WINDOW_BORDERLESS; 
     _hwndMain = SDL_CreateWindow((const char*) strWindow1251ToUtf8(achWindowTitle), SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, pixSizeI, pixSizeJ, _uFlags);
@@ -336,7 +336,7 @@ void OpenMainWindowFullScreen( PIX pixSizeI, PIX pixSizeJ)
 #else
   SDL_snprintf( achWindowTitle, sizeof (achWindowTitle), TRANSV("Serious Sam (FullScreen %dx%d)"), pixSizeI, pixSizeJ);
 #ifdef SE1_VULKAN
-  if( sam_iGfxAPI == 1) {
+  if( sam_iGfxAPI == 1 || sam_iGfxAPI == 2) { // Vulkan raster or Vulkan ray tracing (GAT_RT)
     _hwndMain = SDL_CreateWindow((const char*)strWindow1251ToUtf8(achWindowTitle), SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, pixSizeI, pixSizeJ, SDL_WINDOW_VULKAN | SDL_WINDOW_FULLSCREEN | SDL_WINDOW_BORDERLESS);
     if( _hwndMain!=NULL) {
       CPrintF("SDL: CreateWindow with flag (SDL_WINDOW_VULKAN) Done.\n");
diff --git a/SamTSE/Sources/SeriousSam/SeriousSam.cpp b/SamTSE/Sources/SeriousSam/SeriousSam.cpp
index da515768b2e1733ccee473d95e933f31138e75c3..bc241240ddc9c0248d64a00030237bc78e0230f2 100644
--- a/SamTSE/Sources/SeriousSam/SeriousSam.cpp
+++ b/SamTSE/Sources/SeriousSam/SeriousSam.cpp
@@ -115,6 +115,9 @@ __extern INDEX sam_iGfxAPI = 1; // default opengl //1;         // 1==Vulkan
 #else
 __extern INDEX sam_iGfxAPI = 0;                                // 0==OpenGL
 #endif // SE1_VULKAN
+// RT: for rendering options menu (SSTRE: always present, set at runtime by StartNewMode)
+static INDEX sam_bShowRayTracingOptions = 0;
+static INDEX sam_bShowRasterizationOptions = 1;
 __extern INDEX sam_bFirstStarted = FALSE;
 __extern FLOAT sam_tmDisplayModeReport = 5.0f;
 __extern INDEX sam_bShowAllLevels = FALSE;
@@ -787,6 +790,10 @@ BOOL Init( HINSTANCE hInstance, int nCmdShow, CTString strCmdLine)
   _pShell->DeclareSymbol("user INDEX sam_bToggleConsole;",(void *) &sam_bToggleConsole);
   _pShell->DeclareSymbol("INDEX sam_iStartCredits;", (void *) &sam_iStartCredits);
 
+  // RT (SSTRE: runtime instead of the SE1_RAYTRACING build switch)
+  _pShell->DeclareSymbol("INDEX sam_bShowRayTracingOptions;", (void *) &sam_bShowRayTracingOptions);
+  _pShell->DeclareSymbol("INDEX sam_bShowRasterizationOptions;", (void *) &sam_bShowRasterizationOptions);
+
   InitializeGame();
   _pNetwork->md_strGameID = sam_strGameName;
 
@@ -918,6 +925,10 @@ BOOL Init( HINSTANCE hInstance, int nCmdShow, CTString strCmdLine)
     }
   // if no relevant starting at command line
   } else {
+    // RT: no auto-demos under ray tracing (SSTRE: runtime check instead of SE1_RAYTRACING)
+  #ifdef SE1_VULKAN
+    if ((GfxAPIType)sam_iGfxAPI != GAT_RT)
+  #endif
     StartNextDemo();
   }
   return TRUE;
@@ -978,21 +989,26 @@ void PrintDisplayModeInfo(void)
        if( _pGfx->gl_eCurrentAPI==GAT_OGL) strRes += " (OpenGL)";
 #ifdef PLATFORM_WIN32
 #ifdef SE1_D3D
-  else if( _pGfx->gl_eCurrentAPI==GAT_D3D) strRes += " (Direct3D)";
+  else if (_pGfx->gl_eCurrentAPI == GAT_D3D) strRes += " (Direct3D)";
 #endif // SE1_D3D
 #endif // PLATFORM_WIN32
 #ifdef SE1_VULKAN
   else if (_pGfx->gl_eCurrentAPI == GAT_VK) strRes += " (Vulkan)";
+  else if (_pGfx->gl_eCurrentAPI == GAT_RT) strRes += " (Vulkan Ray Tracing)";
 #endif // SE1_VULKAN
 
 
   CTString strDescr;
   strDescr.PrintF("\n%s (%s)\n", (const char *) _strPreferencesDescription, (const char *) RenderingPreferencesDescription(sam_iVideoSetup));
   strRes+=strDescr;
+
   // tell if application is started for the first time, or failed to set mode
-  if( _iDisplayModeChangeFlag==0) {
+  if( _iDisplayModeChangeFlag==0) 
+  {
     strRes += TRANS("Display mode set by default!");
-  } else if( _iDisplayModeChangeFlag==2) {
+  }
+  else if (_iDisplayModeChangeFlag == 2)
+  {
     strRes += TRANS("Last mode set failed!");
   }
 
@@ -1258,8 +1274,16 @@ int SubMain( HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int
             // pause game
             _pNetwork->TogglePause();
           }
+
+        #ifdef SE1_VULKAN
+          if (_pGfx->gl_eCurrentAPI == GAT_RT) {
+            // RT: don't delete context when the window shoudl be minimized
+            ShowWindow(_hwndMain, SW_MINIMIZE);
+          } else
+        #endif // SE1_VULKAN
           // if in full screen
           if( sam_bFullScreenActive) {
+
             // reset display mode and minimize window
             _pGfx->ResetDisplayMode();
             ShowWindow(_hwndMain, SW_MINIMIZE);
@@ -1268,12 +1292,20 @@ int SubMain( HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int
             // just minimize the window
             ShowWindow(_hwndMain, SW_MINIMIZE);
           }
+
           break;
         // if should restore
         case SC_RESTORE:
           if( _bWindowChanging) break;
           _bWindowChanging  = TRUE;
           _bReconsiderInput = TRUE;
+
+        #ifdef SE1_VULKAN
+          if (_pGfx->gl_eCurrentAPI == GAT_RT) {
+            // RT: don't recreate context when the window should be restored
+            ShowWindow(_hwndMain, SW_SHOWNORMAL);
+          } else
+        #endif // SE1_VULKAN
           // if in full screen
           if( sam_bFullScreenActive) {
             ShowWindow(_hwndMain, SW_SHOWNORMAL);
@@ -1284,7 +1316,8 @@ int SubMain( HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int
           } else {
             // restore window
             ShowWindow(_hwndMain, SW_SHOWNORMAL);
-          }
+          } 
+
           break;
         // if should maximize
         case SC_MAXIMIZE:
@@ -1852,7 +1885,7 @@ BOOL TryToSetDisplayMode( enum GfxAPIType eGfxAPI, INDEX iAdapter, PIX pixSizeI,
 #endif // SE1_D3D
 
   #ifdef SE1_VULKAN
-    if (eGfxAPI == GAT_VK)
+    if (eGfxAPI == GAT_VK || eGfxAPI == GAT_RT)
     {
       OpenMainWindowFullScreen(pixSizeI, pixSizeJ);
     }
@@ -1865,7 +1898,7 @@ BOOL TryToSetDisplayMode( enum GfxAPIType eGfxAPI, INDEX iAdapter, PIX pixSizeI,
     if( eGfxAPI==GAT_D3D) OpenMainWindowNormal( pixSizeI, pixSizeJ);
 #endif // SE1_D3D
 #ifdef SE1_VULKAN
-    if (eGfxAPI == GAT_VK) OpenMainWindowNormal(pixSizeI, pixSizeJ);
+    if (eGfxAPI == GAT_VK || eGfxAPI == GAT_RT) OpenMainWindowNormal(pixSizeI, pixSizeJ);
 #endif // SE1_VULKAN
     bSuccess = _pGfx->ResetDisplayMode( eGfxAPI);
     if( bSuccess && eGfxAPI==GAT_OGL) OpenMainWindowNormal( pixSizeI, pixSizeJ);
@@ -1875,31 +1908,36 @@ BOOL TryToSetDisplayMode( enum GfxAPIType eGfxAPI, INDEX iAdapter, PIX pixSizeI,
   }
 
   // if new mode was set
-  if( bSuccess) {
+  if (bSuccess)
+  {
     // create canvas
-    ASSERT( pvpViewPort==NULL);
-    ASSERT( pdpNormal==NULL);
-    _pGfx->CreateWindowCanvas( _hwndMain, &pvpViewPort, &pdpNormal);
+    ASSERT(pvpViewPort == NULL);
+    ASSERT(pdpNormal == NULL);
+    _pGfx->CreateWindowCanvas(_hwndMain, &pvpViewPort, &pdpNormal);
 
     // erase context of both buffers (for the sake of wide-screen)
     pdp = pdpNormal;
-    if( pdp!=NULL && pdp->Lock()) {
-      pdp->Fill(C_BLACK|CT_OPAQUE);
+    if (pdp != NULL && pdp->Lock())
+    {
+      pdp->Fill(C_BLACK | CT_OPAQUE);
       pdp->Unlock();
       pvpViewPort->SwapBuffers();
       pdp->Lock();
-      pdp->Fill(C_BLACK|CT_OPAQUE);
+      pdp->Fill(C_BLACK | CT_OPAQUE);
       pdp->Unlock();
       pvpViewPort->SwapBuffers();
     }
 
     // lets try some wide screen screaming :)
-    const PIX pixYBegAdj = pdp->GetHeight() * 21/24;
-    const PIX pixYEndAdj = pdp->GetHeight() * 3/24;
-    const PIX pixXEnd    = pdp->GetWidth();
-    pdpWideScreen = new CDrawPort( pdp, PIXaabbox2D( PIX2D(0,pixYBegAdj), PIX2D(pixXEnd, pixYEndAdj)));
+    const PIX pixYBegAdj = pdp->GetHeight() * 21 / 24;
+    const PIX pixYEndAdj = pdp->GetHeight() * 3 / 24;
+    const PIX pixXEnd = pdp->GetWidth();
+    pdpWideScreen = new CDrawPort(pdp, PIXaabbox2D(PIX2D(0, pixYBegAdj), PIX2D(pixXEnd, pixYEndAdj)));
     pdpWideScreen->dp_fWideAdjustment = 9.0f / 12.0f;
-    if( sam_bWideScreen) pdp = pdpWideScreen;
+    if (sam_bWideScreen)
+    {
+      pdp = pdpWideScreen;
+    }
 
     // initial screen fill and swap, just to get context running
     BOOL bSuccess = FALSE;
@@ -1953,6 +1991,10 @@ BOOL TryToSetDisplayMode( enum GfxAPIType eGfxAPI, INDEX iAdapter, PIX pixSizeI,
 // list of possible display modes for recovery 
 const INDEX aDefaultModes[][3] =
 { // color, API, adapter
+#ifdef SE1_VULKAN
+  // RT: recover to Vulkan raster first (SSTRE: then OpenGL, no SE1_RAYTRACING build switch)
+  { DD_DEFAULT, GAT_VK, 0},
+#endif // SE1_VULKAN
   { DD_DEFAULT, GAT_OGL, 0},
   { DD_16BIT,   GAT_OGL, 0},
   { DD_16BIT,   GAT_OGL, 1}, // 3dfx Voodoo2
@@ -2001,13 +2043,18 @@ void StartNewMode( enum GfxAPIType eGfxAPI, INDEX iAdapter, PIX pixSizeI, PIX pi
         "Cannot set display mode!\n"
         "Serious Sam was unable to find display mode with hardware acceleration.\n"
         "Make sure you install proper drivers for your video card as recommended\n"
-        "in documentation and set your desktop to 16 bit (65536 colors).\n"
+        "in documentation.\n"
         "Please see ReadMe file for troubleshooting information.\n"));
     }
 
   // if succeeded
   } else {
     _iDisplayModeChangeFlag = 1;  // all ok
+
+  #ifdef SE1_VULKAN
+    sam_bShowRayTracingOptions = eGfxAPI == GAT_RT;
+  #endif
+    sam_bShowRasterizationOptions = !sam_bShowRayTracingOptions;
   }
 
 	//#################################################################33
