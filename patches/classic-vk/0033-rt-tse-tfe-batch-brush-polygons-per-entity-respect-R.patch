+bool SSRT::SceneBrushes::FitsIntoStaticBudget(const CBrushGeometry &brush)
+{
+  // same accounting as RTGL1's VertexCollector::AddGeometry
+  const uint32_t newGeomCount   = staticGeometryCount + 1;
+  const uint32_t newVertexCount = AlignUpBy3(staticVertexCount) + brush.vertexCount;
+  const uint32_t newIndexCount  = AlignUpBy3(staticIndexCount) + brush.indexCount;
+
+  if (newGeomCount   >= SSRT_RTGL1_MAX_GEOMETRIES - SSRT_RTGL1_RESERVED_DYNAMIC_GEOMS ||
+      newVertexCount >= SSRT_RTGL1_MAX_STATIC_VERTICES ||
+      newIndexCount  >= SSRT_RTGL1_MAX_STATIC_INDICES)
+  {
+    staticDroppedCount++;
+    return false;
+  }
+
+  staticGeometryCount = newGeomCount;
+  staticVertexCount = newVertexCount;
+  staticIndexCount = newIndexCount;
+  return true;
+}
+
+void SSRT::SceneBrushes::OnStaticGeometrySubmitted()
+{
+  if (staticDroppedCount > 0)
+  {
+    CPrintF("RT: %u brush parts exceed the RTGL1 static geometry budget and are not ray traced (%u parts, %u vertices, %u indices uploaded).\n",
+            staticDroppedCount, staticGeometryCount, staticVertexCount, staticIndexCount);
+  }
+}
