+
+// SSTRE: runtime-loaded per-world ray-tracing tuning for SSRT::CustomInfo.
+//
+// Serious-Engine-RT kept its per-level tuning (illumination, culling depth, ignored
+// polygons, cutscene lights, texture class lists, ...) in C++ tables for the 15 TFE
+// worlds. Those tables now live in a text file in the game root, so that other games
+// (TSE) and mods can be tuned without rebuilding the engine:
+//
+//   SSTRE/RT/WorldTuning.txt          shipped with the engine tree (TFE values migrated)
+//   SSTRE/RT/WorldTuning.local.txt    optional, local overrides/additions (not shipped)
+//
+// Format (one statement per line, '#' or ';' starts a comment):
+//   [defaults]               keys applied to every world before its own section
+//   [world <WorldFileName>]  e.g. [world 01_Hatshepsut] (file name without path/extension)
+//   [textures <category>]    one texture path per line, appended to that category
+//   key = value              inside [defaults]/[world]; repeatable keys append to lists
+//
+// Position-dependent special cases of the original code (e.g. TFE Great Pyramid sky
+// animation, Metropolis on Serious, Moon Mountains reflections) remain C++ hooks in
+// CustomInfo.cpp keyed by the world name.
+
+#include <Engine/StdH.h>
+#include <Engine/Base/Console.h>
+#include <Engine/Base/Stream.h>
+#include "CustomInfo.h"
+
+#include <Engine/Raytracing/SSRTGlobals.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+extern SSRT::SSRTGlobals _srtGlobals;
+
+
+static CTString TrimString(const char *str)
+{
+  const char *b = str;
+  while (*b == ' ' || *b == '\t') b++;
+  const char *e = b + strlen(b);
+  while (e > b && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) e--;
+  CTString strResult = b;
+  strResult.TrimRight((INDEX)(e - b));
+  return strResult;
+}
+
+
+// parse up to iMax numbers separated by spaces/commas; returns how many were read
+static int ParseFloats(const char *str, FLOAT *afOut, int iMax)
+{
+  int ct = 0;
+  const char *p = str;
+  while (ct < iMax)
+  {
+    while (*p == ' ' || *p == '\t' || *p == ',') p++;
+    if (*p == 0) break;
+    char *pEnd = nullptr;
+    double d = strtod(p, &pEnd);
+    if (pEnd == p) break;
+    afOut[ct++] = (FLOAT)d;
+    p = pEnd;
+  }
+  return ct;
+}
+
+
+static int ParseIndices(const char *str, std::vector<INDEX> &aOut)
+{
+  FLOAT af[256];
+  int ct = ParseFloats(str, af, 256);
+  for (int i = 0; i < ct; i++)
+  {
+    aOut.push_back((INDEX)af[i]);
+  }
+  return ct;
+}
+
+
+static RgGeometryPrimaryVisibilityType MaskBitFromIndex(INDEX i)
+{
+  switch (i)
+  {
+    case 1:  return RG_GEOMETRY_VISIBILITY_TYPE_WORLD_1;
+    case 2:  return RG_GEOMETRY_VISIBILITY_TYPE_WORLD_2;
+    default: return RG_GEOMETRY_VISIBILITY_TYPE_WORLD_0;
+  }
+}
+
+
+bool SSRT::CustomInfo::ApplyTuningKey(const CTString &strKey, const CTString &strValue)
+{
+  const char *k = strKey.str_String;
+  const char *v = strValue.str_String;
+
+  FLOAT af[8];
+  const int ctF = ParseFloats(v, af, 8);
+
+  // scalar FLOAT keys mapped directly to SSRT globals
+  const struct { const char *pName; FLOAT *pDst; } aFloatKeys[] =
+  {
+    { "sun_intensity",                           &_srtGlobals.srt_fSunIntensity },
+    { "sun_saturation",                          &_srtGlobals.srt_fSunSaturation },
+    { "sky_color_multiplier",                    &_srtGlobals.srt_fSkyColorMultiplier },
+    { "sky_color_saturation",                    &_srtGlobals.srt_fSkyColorSaturation },
+    { "tonemapping_min_log_luminance",           &_srtGlobals.srt_fTonemappingMinLogLuminance },
+    { "potential_light_sph_falloff_default",     &_srtGlobals.srt_fPotentialLightSphFalloffDefault },
+    { "potential_light_sph_falloff_multiplier",  &_srtGlobals.srt_fPotentialLightSphFalloffMultiplier },
+    { "original_light_sph_falloff_multiplier",   &_srtGlobals.srt_fOriginalLightSphFalloffMultiplier },
+    { "potential_light_sph_falloff_min",         &_srtGlobals.srt_fPotentialLightSphFalloffMin },
+    { "flashlight_angle_outer",                  &_srtGlobals.srt_fFlashlightAngleOuter },
+    { "flashlight_falloff_distance",             &_srtGlobals.srt_fFlashlightFalloffDistance },
+    { "water_density_multiplier",                &_srtGlobals.srt_fWaterDensityMultiplier },
+    { "skybox_cloudy_intensity",                 &fSkyboxCloudyIntensity },
+    { "potential_light_distance_threshold",      &tuning.fPotentialLightThreshold },
+    { "flashlight_hint_delay",                   &tuning.fFlashlightHintDelay },
+    { "flashlight_hint_duration",                &tuning.fFlashlightHintDuration },
+  };
+
+  for (const auto &f : aFloatKeys)
+  {
+    if (strcmp(k, f.pName) == 0)
+    {
+      if (ctF < 1) return false;
+      *f.pDst = af[0];
+      return true;
+    }
+  }
+
+  if (strcmp(k, "tuned") == 0)                     { if (ctF < 1) return false; tuning.bTuned = af[0] != 0; return true; }
+  if (strcmp(k, "culling_max_sector_depth") == 0)  { if (ctF < 1) return false; _srtGlobals.srt_iCullingMaxSectorDepth = (INDEX)af[0]; return true; }
+  if (strcmp(k, "ignore_dynamic_texcoords") == 0)  { if (ctF < 1) return false; _srtGlobals.srt_bIgnoreDynamicTexCoords = af[0] != 0; return true; }
+  if (strcmp(k, "haze") == 0)                      { if (ctF < 1) return false; tuning.bHazeAllowed = af[0] != 0; return true; }
+  if (strcmp(k, "only_reflect_water") == 0)        { if (ctF < 1) return false; tuning.bOnlyReflectWater = af[0] != 0; return true; }
+  if (strcmp(k, "sun_depends_on_clouds") == 0)     { if (ctF < 1) return false; bSunIntensityDependsOnSkyClouds = af[0] != 0; return true; }
+  if (strcmp(k, "skybox_depends_on_clouds") == 0)  { if (ctF < 1) return false; bSkyboxIntensityDependsOnSkyClouds = af[0] != 0; return true; }
+
+  if (strcmp(k, "sky_type") == 0)
+  {
+    if (strcmp(v, "color") == 0)    { tuning.eSkyType = RG_SKY_TYPE_COLOR; return true; }
+    if (strcmp(v, "geometry") == 0) { tuning.eSkyType = RG_SKY_TYPE_RASTERIZED_GEOMETRY; return true; }
+    return false;
+  }
+
+  if (strcmp(k, "water_extinction") == 0)
+  {
+    if (ctF < 3) return false;
+    _srtGlobals.srt_vWaterExtinction = FLOAT3D(af[0], af[1], af[2]);
+    return true;
+  }
+
+  // animated_sun = <time offset start> <time length> <target pitch heading bank>
+  if (strcmp(k, "animated_sun") == 0)
+  {
+    if (ctF < 5) return false;
+    _srtGlobals.srt_fAnimatedSunTimeOffsetStart = af[0];
+    _srtGlobals.srt_fAnimatedSunTimeLength = af[1];
+    _srtGlobals.srt_vAnimatedSunTargetEuler = FLOAT3D(af[2], af[3], af[4]);
+    return true;
+  }
+
+  // ignore_world_base = x y z <can be zoning 0/1>   (repeatable)
+  if (strcmp(k, "ignore_world_base") == 0)
+  {
+    if (ctF < 4) return false;
+    worldBasePositionsToIgnore.push_back(FLOAT3D(af[0], af[1], af[2]));
+    bCheckOnlyZoningForBrushIgnored &= (af[3] != 0);
+    return true;
+  }
+
+  if (strcmp(k, "ignore_directional_light") == 0)
+  {
+    if (v[0] == 0) return false;
+    dirLightsNamesToIgnore.push_back(v);
+    return true;
+  }
+
+  // cutscene_light = x y z   (repeatable)
+  if (strcmp(k, "cutscene_light") == 0)
+  {
+    if (ctF < 3) return false;
+    cutsceneLightPositions.push_back(FLOAT3D(af[0], af[1], af[2]));
+    return true;
+  }
+
+  if (strcmp(k, "ignore_polygons") == 0)
+  {
+    std::vector<INDEX> a;
+    if (ParseIndices(v, a) < 1) return false;
+    for (INDEX i : a) brushPolygonsToIgnore.push_back({ i });
+    return true;
+  }
+
+  if (strcmp(k, "ignore_sectors") == 0)
+  {
+    std::vector<INDEX> a;
+    if (ParseIndices(v, a) < 1) return false;
+    for (INDEX i : a) brushSectorsToIgnore.push_back({ i });
+    return true;
+  }
+
+  // ignore_polygon_range = first last   (inclusive, repeatable)
+  if (strcmp(k, "ignore_polygon_range") == 0)
+  {
+    if (ctF < 2) return false;
+    brushPolygonRangesToIgnore.push_back({ (INDEX)af[0], (INDEX)af[1] });
+    return true;
+  }
+
+  // mask_polygons = <world mask 1|2> poly poly ...
+  if (strcmp(k, "mask_polygons") == 0)
+  {
+    std::vector<INDEX> a;
+    if (ParseIndices(v, a) < 2) return false;
+    for (size_t i = 1; i < a.size(); i++) brushPolygonsToMask.push_back({ a[i], MaskBitFromIndex(a[0]) });
+    return true;
+  }
+
+  // mask_sectors = <world mask 1|2> sector sector ...
+  if (strcmp(k, "mask_sectors") == 0)
+  {
+    std::vector<INDEX> a;
+    if (ParseIndices(v, a) < 2) return false;
+    for (size_t i = 1; i < a.size(); i++) brushSectorsToMask.push_back({ a[i], MaskBitFromIndex(a[0]) });
+    return true;
+  }
+
+  // mask_polygon_range = <world mask 1|2> first last   (inclusive, repeatable)
+  if (strcmp(k, "mask_polygon_range") == 0)
+  {
+    if (ctF < 3) return false;
+    brushPolygonRangesToMask.push_back({ (INDEX)af[1], (INDEX)af[2], MaskBitFromIndex((INDEX)af[0]) });
+    return true;
+  }
+
+  if (strcmp(k, "haze_ignored_sectors") == 0)
+  {
+    return ParseIndices(v, tuning.aHazeIgnoredSectors) > 0;
+  }
+
+  return false;
+}
+
+
+void SSRT::CustomInfo::LoadTuningFile(const char *strFileName, const CTString &strWorldName)
+{
+  const CTFileName fnm = CTString(strFileName);
+
+  if (!FileExists(fnm))
+  {
+    return;
+  }
+
+  enum { SEC_NONE, SEC_APPLY, SEC_SKIP, SEC_TEXTURES } eSection = SEC_NONE;
+  std::vector<std::string> *pTexList = nullptr;
+  INDEX iLine = 0;
+  INDEX ctApplied = 0;
+
+  try
+  {
+    CTFileStream strm;
+    strm.Open_t(fnm);
+
+    while (!strm.AtEOF())
+    {
+      char achLine[1024] = {};
+      strm.GetLine_t(achLine, sizeof(achLine) - 1);
+      iLine++;
+
+      // strip comments
+      for (char *c = achLine; *c != 0; c++)
+      {
+        if (*c == '#' || *c == ';') { *c = 0; break; }
+      }
+
+      CTString strLine = TrimString(achLine);
+      if (strLine == "")
+      {
+        continue;
+      }
+
+      const char *l = strLine.str_String;
+
+      if (l[0] == '[')
+      {
+        const char *pEnd = strchr(l, ']');
+        if (pEnd == nullptr)
+        {
+          CPrintF("RT tuning: %s:%d: malformed section\n", strFileName, iLine);
+          eSection = SEC_SKIP;
+          continue;
+        }
+
+        CTString strSection = l + 1;
+        strSection.TrimRight((INDEX)(pEnd - l - 1));
+        strSection = TrimString(strSection.str_String);
+        const char *s = strSection.str_String;
+
+        pTexList = nullptr;
+
+        if (strSection == "defaults")
+        {
+          eSection = SEC_APPLY;
+        }
+        else if (strncmp(s, "world ", 6) == 0)
+        {
+          eSection = (TrimString(s + 6) == strWorldName) ? SEC_APPLY : SEC_SKIP;
+        }
+        else if (strncmp(s, "textures ", 9) == 0)
+        {
+          eSection = SEC_TEXTURES;
+          std::string strCategory = TrimString(s + 9).str_String;
+
+          for (auto &c : tuning.aTexturePaths)
+          {
+            if (c.first == strCategory) { pTexList = &c.second; break; }
+          }
+          if (pTexList == nullptr)
+          {
+            tuning.aTexturePaths.push_back({ strCategory, {} });
+            pTexList = &tuning.aTexturePaths.back().second;
+          }
+        }
+        else
+        {
+          CPrintF("RT tuning: %s:%d: unknown section '%s'\n", strFileName, iLine, s);
+          eSection = SEC_SKIP;
+        }
+        continue;
+      }
+
+      if (eSection == SEC_TEXTURES)
+      {
+        pTexList->push_back(l);
+        continue;
+      }
+
+      if (eSection != SEC_APPLY)
+      {
+        continue;
+      }
+
+      const char *pEq = strchr(l, '=');
+      if (pEq == nullptr)
+      {
+        CPrintF("RT tuning: %s:%d: expected 'key = value'\n", strFileName, iLine);
+        continue;
+      }
+
+      CTString strKey = l;
+      strKey.TrimRight((INDEX)(pEq - l));
+      strKey = TrimString(strKey.str_String);
+      CTString strValue = TrimString(pEq + 1);
+
+      if (ApplyTuningKey(strKey, strValue))
+      {
+        ctApplied++;
+      }
+      else
+      {
+        CPrintF("RT tuning: %s:%d: invalid key or value '%s'\n", strFileName, iLine, l);
+      }
+    }
+  }
+  catch (const char *strError)
+  {
+    CPrintF("RT tuning: cannot read %s: %s\n", strFileName, strError);
+    return;
+  }
+
+  CPrintF("RT tuning: %s: %d values applied for '%s'\n", strFileName, ctApplied, strWorldName.str_String);
+}
+
+
+void SSRT::CustomInfo::LoadTuning()
+{
+  const CTString strWorldName = pWorld->wo_fnmFileName.FileName();
+
+  const bool bHasMain = FileExists(CTString("SSTRE\\RT\\WorldTuning.txt")) != FALSE;
+  if (!bHasMain)
+  {
+    CPrintF("RT tuning: SSTRE\\RT\\WorldTuning.txt not found, using generic defaults\n");
+  }
+
+  LoadTuningFile("SSTRE\\RT\\WorldTuning.txt", strWorldName);
+  LoadTuningFile("SSTRE\\RT\\WorldTuning.local.txt", strWorldName);
+}
