From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lethalbas <lethalbas@gmail.com>
Date: Fri, 27 Nov 2026 21:59:42 +0100
Subject: [PATCH] rt(engine): log failed RTGL1 calls in release builds

RG_CHECKERROR was ASSERT(x == RG_SUCCESS), so every RTGL1 error was
silently dropped in Release. It now reports the RgResult, its description
and the call site to the console (first 50 occurrences), and still
asserts in debug builds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 SamTFE/Sources/Engine/Raytracing/SSRT.cpp      | 9 +++++++++
 SamTFE/Sources/Engine/Raytracing/SSRTObjects.h | 5 ++++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/SamTFE/Sources/Engine/Raytracing/SSRT.cpp b/SamTFE/Sources/Engine/Raytracing/SSRT.cpp
index 9c070db22524ba0af739074cda2dc73f0de66eff..5df73921297dbd69283775f82fc2fbdff63e3258 100644
--- a/SamTFE/Sources/Engine/Raytracing/SSRT.cpp
+++ b/SamTFE/Sources/Engine/Raytracing/SSRT.cpp
@@ -296,6 +296,15 @@ void SSRT::SSRTMain::NormalizeShellVariables()
 }
 
 
+// SSTRE: rate-limited report of failed rg*() calls (see RG_CHECKERROR)
+void SSRT_ReportRgError(int iResult, const char *strFile, int iLine)
+{
+  static INDEX ctReported = 0;
+  if (ctReported >= 50) return;
+  ctReported++;
+  CPrintF("RTGL1 error %d (%s) at %s:%d\n", iResult, rgGetResultDescription((RgResult)iResult), strFile, iLine);
+}
+
 static void DebugPrint(const char *pMessage, void *pUserData)
 {
   CPrintF(pMessage);
diff --git a/SamTFE/Sources/Engine/Raytracing/SSRTObjects.h b/SamTFE/Sources/Engine/Raytracing/SSRTObjects.h
index 8f98d8faeec312b9f9c64e6598bd052e5d026b8b..9980b20ffaaa385af426061cdf27c64f2e3a900c 100644
--- a/SamTFE/Sources/Engine/Raytracing/SSRTObjects.h
+++ b/SamTFE/Sources/Engine/Raytracing/SSRTObjects.h
@@ -19,7 +19,10 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 #include <Engine/Brushes/Brush.h>
 #include <RTGL1/RTGL1.h>
 
-#define RG_CHECKERROR(x) ASSERT(x == RG_SUCCESS)
+// SSTRE: in release builds, report RTGL1 failures to the console (rate-limited) instead of
+// dropping them; debug builds still assert
+void SSRT_ReportRgError(int iResult, const char *strFile, int iLine);
+#define RG_CHECKERROR(x) do { if ((x) != RG_SUCCESS) { SSRT_ReportRgError((int)(x), __FILE__, __LINE__); ASSERT((x) == RG_SUCCESS); } } while (0)
 
 class CRenderModel;
 
