+      <Command Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp -Psyy %(RootDir)%(Directory)\smcScwin.l</Command>
+      <Command Condition="'$(Configuration)|$(Platform)'=='Release|x64'">win_flex -o%(RootDir)%(Directory)\smcScan.cpp -Psyy %(RootDir)%(Directory)\smcScwin.l</Command>
