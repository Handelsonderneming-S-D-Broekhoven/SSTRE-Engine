 {
   if (brush.vertices == nullptr || brush.vertexCount == 0 || brush.indices == nullptr || brush.indexCount == 0)
@@ -65,6 +110,12 @@ void SSRT::SceneBrushes::RegisterBrush(const CBrushGeometry &brush)
