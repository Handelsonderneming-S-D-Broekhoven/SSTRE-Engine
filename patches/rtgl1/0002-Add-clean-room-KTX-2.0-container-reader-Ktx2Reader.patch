+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright (C) 2026 Handelsonderneming S.D. Broekhoven, trading as ITEagle Europe
+#
+# Generates Source/Ktx2FormatTable.inl for the clean-room KTX2 reader.
+#
+# Inputs (facts only):
+#   - formats.json from the Khronos KTX-Specification repository
+#     (format names, typeSize, block dimensions)
+#   - vulkan_core.h from the Vulkan SDK (numeric VkFormat values)
+# The texel block byte size is derived from the format name following the
+# "Format Compatibility Classes" of the Vulkan specification and the three
+# exceptions listed in the KTX 2.0 specification, section "mipPadding".
+#
+# Usage: python GenKtx2FormatTable.py <formats.json> <vulkan_core.h> <out.inl>
+
+import json
+import re
+import sys
+
+
+def parse_vk_formats(header_path):
+    values = {}
+    aliases = {}
+    pat = re.compile(r"^\s*(VK_FORMAT_[A-Z0-9_x]+)\s*=\s*([A-Za-z0-9_]+),?")
+    in_enum = False
+    with open(header_path, encoding="utf-8") as f:
+        for line in f:
+            if line.startswith("typedef enum VkFormat {"):
+                in_enum = True
+                continue
+            if in_enum and line.startswith("} VkFormat;"):
+                break
+            if not in_enum:
+                continue
+            m = pat.match(line)
+            if not m:
+                continue
+            name, val = m.group(1), m.group(2)
+            if val.isdigit():
+                values[name] = int(val)
+            else:
+                aliases[name] = val
+    for name, target in aliases.items():
+        if target in values:
+            values[name] = values[target]
+    return values
+
+
+# 8-byte compressed blocks; every other BC/ETC/EAC/ASTC block is 16 bytes.
+EIGHT_BYTE_BLOCKS = (
+    "BC1_", "BC4_",
+    "ETC2_R8G8B8_", "ETC2_R8G8B8A1_",
+    "EAC_R11_",
+)
+
+DEPTH_STENCIL_OVERRIDES = {
+    # KTX 2.0 spec, mipPadding table, and Vulkan compatibility classes.
+    "VK_FORMAT_D16_UNORM_S8_UINT": 4,
+    "VK_FORMAT_D24_UNORM_S8_UINT": 4,
+    "VK_FORMAT_D32_SFLOAT_S8_UINT": 8,
+}
+
+
+def block_bytes(entry):
+    name = entry["vkFormat"]
+    short = name[len("VK_FORMAT_"):]
+    kind = entry["type"]
+    if name in DEPTH_STENCIL_OVERRIDES:
+        return DEPTH_STENCIL_OVERRIDES[name]
+    if kind in ("BC", "ETC"):
+        return 8 if short.startswith(EIGHT_BYTE_BLOCKS) else 16
+    if kind == "ASTC":
+        return 16
+    if kind == "PVRTC":
+        return None  # not supported by this reader
+    m = re.search(r"_(\d)PACK(\d+)", short)
+    if m:
+        return int(m.group(1)) * int(m.group(2)) // 8
+    m = re.search(r"_PACK(\d+)", short)
+    if m:
+        return int(m.group(1)) // 8
+    comps = short.split("_")[0]
+    bits = sum(int(b) for b in re.findall(r"[A-Z](\d+)", comps))
+    if bits == 0 or bits % 8 != 0:
+        raise ValueError("cannot derive block size for " + name)
+    return bits // 8
+
+
+def main():
+    formats = json.load(open(sys.argv[1], encoding="utf-8"))
+    vk = parse_vk_formats(sys.argv[2])
+    rows = []
+    for e in formats:
+        name = e["vkFormat"]
+        if name not in vk:
+            continue  # e.g. 3D ASTC formats absent from the Vulkan headers
+        bb = block_bytes(e)
+        if bb is None:
+            continue
+        rows.append((vk[name], bb, e["blockWidth"], e["blockHeight"],
+                     e["blockDepth"], e["typeSize"], name))
+    rows.sort()
+    seen = set()
+    with open(sys.argv[3], "w", encoding="utf-8", newline="\n") as out:
+        out.write("// SPDX-License-Identifier: GPL-2.0-only\n")
+        out.write("// Copyright (C) 2026 Handelsonderneming S.D. Broekhoven, trading as ITEagle Europe\n")
+        out.write("//\n// Generated by Tools/GenKtx2FormatTable.py - do not edit.\n")
+        out.write("// { vkFormat, blockBytes, blockWidth, blockHeight, blockDepth, typeSize }\n")
+        for r in rows:
+            if r[0] in seen:
+                continue
+            seen.add(r[0])
+            out.write("{ %10d, %2d, %2d, %2d, %2d, %d }, // %s\n" % r)
+    print("wrote %d formats" % len(seen))
+
+
+if __name__ == "__main__":
+    main()
