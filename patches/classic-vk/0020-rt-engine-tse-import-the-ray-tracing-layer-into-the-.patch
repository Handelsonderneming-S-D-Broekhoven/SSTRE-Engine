+// CRenderer::RenderModels(BOOL bBackground)
+static void RT_Post_RenderModels(CEntity &en, 
+                                 CModelObject &mo, 
+                                 SSRT::Scene *scene)
+{
+  if (!gfx_bRenderModels)
+  {
+    return;
+  }
+
+  RT_RenderOneModel(en, mo, en.GetLerpedPlacement(), 0, TRUE, 0, scene);
+}
