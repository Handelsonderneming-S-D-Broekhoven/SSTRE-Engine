+template<class Type>
+inline Type SmoothStep(const Type edge0, const Type edge1, const Type x)
+{
+  Type t = Clamp((x - edge0) / (edge1 - edge0), (Type)0.0, (Type)1.0);
+  return t * t * (3.0 - 2.0 * t);
+}
