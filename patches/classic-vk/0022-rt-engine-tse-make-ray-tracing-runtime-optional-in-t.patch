 #endif
 
 
@@ -41,6 +42,46 @@ extern const D3DDEVTYPE d3dDevType;
 // list of all modes avaliable through CDS
 static CListHead _lhCDSModes;
 
+#ifdef SE1_VULKAN
+// Ray-tracing adapter enumeration, from Serious-Engine-RT (Sultim Tsyrendashiev) InitAPIs.
+// SSTRE change: a GPU without ray tracing is not a fatal error any more; GAT_RT just
+// gets 0 adapters, so the conventional raster APIs keep working.
+static void InitAPIs_RayTracing(CGfxAPI *agaAPI, const VkPhysicalDevice *physDevices, uint32_t ctPhysDevices)
+{
+  INDEX iRTGPU = 0;
+  for (uint32_t iAdapter = 0; iAdapter < ctPhysDevices; iAdapter++)
+  {
+    VkPhysicalDeviceRayTracingPipelineFeaturesKHR rtFeatures = {};
+    rtFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_TRACING_PIPELINE_FEATURES_KHR;
+
+    VkPhysicalDeviceFeatures2 deviceFeatures2 = {};
+    deviceFeatures2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+    deviceFeatures2.pNext = &rtFeatures;
+    vkGetPhysicalDeviceFeatures2(physDevices[iAdapter], &deviceFeatures2);
+
+    if (rtFeatures.rayTracingPipeline)
+    {
+      // if has RT support, then assign info from VK
+      agaAPI[GAT_RT].ga_adaAdapter[iRTGPU] = agaAPI[GAT_VK].ga_adaAdapter[iAdapter];
+      iRTGPU++;
+    }
+  }
+
+  agaAPI[GAT_RT].ga_ctAdapters = iRTGPU;
+  agaAPI[GAT_RT].ga_iCurrentAdapter = 0;
+
+  if (iRTGPU == 0)
+  {
+    CPrintF("No GPU with Vulkan ray tracing found; ray tracing (GAT_RT) is unavailable.\n");
+  }
+  else if (!RTGL1_IsAvailable())
+  {
+    // GPU can ray trace, but the optional RTGL1 library is not installed
+    agaAPI[GAT_RT].ga_ctAdapters = 0;
+  }
+}
+#endif // SE1_VULKAN
+
 #ifdef PLATFORM_WIN32 // DG: all this code is (currently?) only used for windows.
 class CResolution {
 public:
@@ -267,6 +308,11 @@ void CGfxLibrary::InitAPIs(void)
   gl_gaAPI[GAT_VK].ga_ctAdapters = ctMaxPhysDevices;
   gl_gaAPI[GAT_VK].ga_iCurrentAdapter = 0;
 
+
+  // SSTRE: enumerate ray-tracing capable adapters for GAT_RT (never fatal)
+  InitAPIs_RayTracing(gl_gaAPI, physDevices, ctMaxPhysDevices);
+
+
   // destroy temporary instance
   vkDestroyInstance(tempVkInstance, nullptr);
 #endif // SE1_VULKAN
@@ -490,6 +536,9 @@ void CGfxLibrary::InitAPIs(void)
