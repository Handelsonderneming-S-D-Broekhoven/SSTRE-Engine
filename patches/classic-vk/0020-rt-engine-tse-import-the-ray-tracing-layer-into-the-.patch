+SSRT::Scene::~Scene()
+{
+#ifndef NDEBUG
+  CPrintF("SSRT scene was deleted.\n");
+#endif // !NDEBUG
+
+  RT_SetCustomInfoForTextures(nullptr);
+
+  delete pSceneBrushes;
+  delete pCustomInfo;
+
+  // submit empty scene to destroy current
+  RgResult r = rgStartNewScene(instance);
+  RG_CHECKERROR(r);
+  r = rgSubmitStaticGeometries(instance);
+  RG_CHECKERROR(r);
