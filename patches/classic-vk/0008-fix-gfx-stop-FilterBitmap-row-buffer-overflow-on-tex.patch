 #include <Engine/Base/Statistics_Internal.h>
+#include <Engine/Base/Console.h> // SSTRE (EXP-016): CPrintF
 #include <Engine/Graphics/GfxLibrary.h>
 #include <Engine/Graphics/RenderPoly.h>
 #include <Engine/Graphics/Color.h>
@@ -1222,7 +1223,18 @@ __int64 mmAdd = 0x0007000700070007;
 #endif
 
 // temp rows for in-place filtering support
-extern "C" { ULONG aulRows[2048]; }
+/* SSTRE modification (EXP-016), 2026-11-27:
+   Copyright (C) 2026 Handelsonderneming S.D. Broekhoven, trading as ITEagle Europe
+   SPDX-License-Identifier: GPL-2.0-only
+
+   FilterBitmap() keeps one filtered row in aulRows and walks it across the full
+   bitmap width. The array held 2048 texels, so any texture wider than 2048 px
+   overflowed it while being filtered (tex_iFiltering!=0) during load and
+   corrupted neighbouring globals (access violation on 4096-px-wide textures).
+   The buffer now holds FILTERROWS_MAX texels and wider bitmaps are left
+   unfiltered instead of overflowing it. */
+#define FILTERROWS_MAX 16384
+extern "C" { ULONG aulRows[FILTERROWS_MAX]; }
 
 // FilterBitmap() INTERNAL: generates convolution filter matrix if needed
 static INDEX iLastFilter;
@@ -1361,6 +1373,19 @@ void FilterBitmap( INDEX iFilter, ULONG *pulSrc, ULONG *pulDst, PIX pixWidth, PI
     return;
   }
 
+  // SSTRE (EXP-016): row buffer holds FILTERROWS_MAX texels; never overflow it
+  if( pixWidth>FILTERROWS_MAX)
+  { // leave unfiltered, but eventually copy
+    static BOOL bReported = FALSE;
+    if( !bReported) {
+      CPrintF( "FilterBitmap: %d px wide bitmap not filtered (limit %d)\n", pixWidth, FILTERROWS_MAX);
+      bReported = TRUE;
+    }
+    if( pulDst!=pulSrc) memcpy( pulDst, pulSrc, pixCanvasWidth*pixCanvasHeight *BYTES_PER_TEXEL);
+    _pfGfxProfile.StopTimer( CGfxProfile::PTI_FILTERBITMAP);
+    return;
+  }
+
   // prepare convolution matrix and row modulo
   iFilter = Clamp( iFilter, (INDEX)-6, (INDEX)6);
   GenerateConvolutionMatrix( iFilter);
