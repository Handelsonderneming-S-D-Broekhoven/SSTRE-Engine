+// SSTRE: RTGL1 static capacity (RTGL1 Generated/ShaderCommonC.h, VertexCollector::AddGeometry).
+// Static and dynamic geometries share MAX_BOTTOM_LEVEL_GEOMETRIES_COUNT (4096) slots, so a part
+// of it is reserved for the dynamic geometry (models, particles) of each frame.
+// RTGL1 drops geometry beyond these limits without returning an error.
+static constexpr uint32_t SSRT_RTGL1_MAX_GEOMETRIES          = 4096;
+static constexpr uint32_t SSRT_RTGL1_RESERVED_DYNAMIC_GEOMS  = 1024;
+static constexpr uint32_t SSRT_RTGL1_MAX_STATIC_VERTICES     = 1048576;
+static constexpr uint32_t SSRT_RTGL1_MAX_STATIC_INDICES      = 1048576 * 3;
+
+static uint32_t AlignUpBy3(uint32_t x)
+{
+  return ((x + 2) / 3) * 3;
+}
+
 
 SSRT::SceneBrushes::SceneBrushes(RgInstance _instance, CWorld *_pWorld, TextureUploader *_pTextureUploader)
-  : instance(_instance), pTextureUploader(_pTextureUploader), bRefreshMovableStates(false)
+  : instance(_instance), pTextureUploader(_pTextureUploader), bRefreshMovableStates(false),
+    staticGeometryCount(0), staticVertexCount(0), staticIndexCount(0), staticDroppedCount(0)
 {
 }
 
